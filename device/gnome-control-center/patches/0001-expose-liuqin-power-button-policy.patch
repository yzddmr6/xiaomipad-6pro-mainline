From: liuqin integration <noreply@localhost>
Subject: [PATCH] expose platform power-key choices in the native power panel
Base: Ubuntu 1:50.0-0ubuntu6 with its complete Debian patch series

--- a/panels/power/cc-power-panel.c
+++ b/panels/power/cc-power-panel.c
@@ -87,6 +87,7 @@
   AdwPreferencesGroup *suspend_notice_group;
 
   GSettings     *gsd_settings;
+  GSettings     *platform_power_settings;
   GSettings     *session_settings;
   GSettings     *interface_settings;
   UpClient      *up_client;
@@ -585,6 +586,20 @@
   guint n_options = 0;
   guint i;
 
+  /* A platform duration handler owns KEY_POWER, while the native power
+   * panel remains the user's configuration entry point. */
+  if (self->platform_power_settings)
+    {
+      cc_number_row_add_value_full (self->power_button_row, 0,
+                                    _("Lock Screen and Turn Off Display"), CC_NUMBER_ORDER_DEFAULT);
+      if (self->can_suspend >= ACTION_INTERACTIVE)
+        cc_number_row_add_value_full (self->power_button_row, 1,
+                                      _("Suspend"), CC_NUMBER_ORDER_DEFAULT);
+      cc_number_row_add_value_full (self->power_button_row, 2,
+                                    _("Nothing"), CC_NUMBER_ORDER_DEFAULT);
+      return TRUE;
+    }
+
   if (g_strv_contains (hidden_on_chassis, self->chassis_type))
     return FALSE;
 
@@ -1295,8 +1310,9 @@
   if (populate_power_button_row (self))
     {
       gtk_widget_set_visible (GTK_WIDGET (self->power_button_row), TRUE);
-      cc_number_row_bind_settings (self->power_button_row, self->gsd_settings,
-                                   "power-button-action");
+      cc_number_row_bind_settings (self->power_button_row,
+                                   self->platform_power_settings ? self->platform_power_settings : self->gsd_settings,
+                                   self->platform_power_settings ? "short-press-action" : "power-button-action");
       show_section = TRUE;
     }
 
@@ -1347,6 +1363,7 @@
   CcPowerPanel *self = CC_POWER_PANEL (object);
 
   g_clear_pointer (&self->chassis_type, g_free);
+  g_clear_object (&self->platform_power_settings);
   g_clear_object (&self->gsd_settings);
   g_clear_object (&self->session_settings);
   g_clear_object (&self->interface_settings);
@@ -1435,6 +1452,23 @@
                                               GTK_STYLE_PROVIDER_PRIORITY_APPLICATION);
 
   self->chassis_type = cc_hostname_get_chassis_type (cc_hostname_get_default ());
+  /* Load the platform duration-handler settings. */
+  {
+    g_autoptr (GSettingsSchemaSource) platform_source = NULL;
+    g_autoptr (GSettingsSchema) schema = NULL;
+    const char *schema_dir = g_getenv ("LIUQIN_POWER_SCHEMA_DIR");
+    if (!schema_dir)
+      schema_dir = "/usr/share/liuqin/power";
+    platform_source = g_settings_schema_source_new_from_directory (schema_dir,
+                           g_settings_schema_source_get_default (), FALSE, NULL);
+    if (platform_source)
+      schema = g_settings_schema_source_lookup (platform_source, "io.github.liuqin.power", TRUE);
+    if (schema)
+      {
+        self->platform_power_settings = g_settings_new_full (schema, NULL, NULL);
+      }
+  }
+
 
   self->up_client = up_client_new ();
   self->devices = self->up_client ? up_client_get_devices2 (self->up_client) : g_ptr_array_new ();
