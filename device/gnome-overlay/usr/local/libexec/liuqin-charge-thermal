#!/usr/bin/python3
"""Apply the M81 stock battery cooling profile and supervise charger-only authentication."""
import argparse
import glob
import os
from pathlib import Path
import signal
import socket
import subprocess
import sys
import time

BAT = Path('/sys/class/power_supply/qcom-battmgr-bat')
USB = Path('/sys/class/power_supply/qcom-battmgr-usb')
CHIPS = ('quiet_therm', 'charger_therm0', 'wifi_therm', 'cpu_therm')
WEIGHTS = (800, -74, 131, -46, 184)
TRIGGER = (37000, 39000, 41000, 42000, 43000, 45000)
CLEAR = (35000, 37000, 40000, 41000, 42000, 44000)
ON = (0, 2, 3, 7, 9, 12, 15)
OFF = (0, 0, 1, 3, 4, 5, 15)


def virtual_temperature(temperatures):
    return sum(t * w for t, w in zip(temperatures, WEIGHTS, strict=True)) // 1000 - 389


def tier(previous, temperature):
    while previous < len(TRIGGER) and temperature >= TRIGGER[previous]:
        previous += 1
    while previous and temperature < CLEAR[previous-1]:
        previous -= 1
    return previous


def single(pattern):
    paths = glob.glob(pattern)
    if len(paths) != 1:
        raise ValueError('missing or ambiguous ' + pattern)
    return Path(paths[0])


def read_int(path):
    return int(path.read_text().strip())


def temperatures():
    values = [read_int(BAT/'temp') * 100]
    for chip in CHIPS:
        path = single('/sys/bus/iio/devices/iio:device*/in_temp*_' + chip + '_input')
        values.append(read_int(path))
    # Use the numerical endpoints of the matching 168-entry stock PM7 table.
    if any(value < -40960 or value > 130048 for value in values):
        raise ValueError('temperature outside the sensor conversion table')
    return values


def screen_on():
    # OEM changes this selector on panel blank/unblank, not at minimum
    # brightness. A missing or ambiguous DRM state uses the warmer profile.
    try:
        connector = single('/sys/class/drm/card*-DSI-*/dpms')
        return connector.read_text().strip() != 'Off'
    except (OSError, ValueError):
        return True


def stop_auth(worker):
    if worker is not None and worker.poll() is None:
        try:
            os.killpg(worker.pid, signal.SIGTERM)
        except ProcessLookupError:
            return
        try:
            worker.wait(timeout=5)
        except subprocess.TimeoutExpired:
            os.killpg(worker.pid, signal.SIGKILL)
            worker.wait()


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument('--charger-only', action='store_true')
    parser.add_argument('--cold-attach-auth', action='store_true')
    args = parser.parse_args()
    root = Path('/proc/device-tree')
    compatible = (root/'compatible').read_bytes().split(b'\0')
    native = b'xiaomi,liuqin' in compatible
    stock = (b'qcom,cape-mtp' in compatible and
             (root/'model').read_bytes().rstrip(b'\0') == b'Liuqin based on Qualcomm Technologies, Inc SM8475')
    if not (native or stock):
        return 2
    helper = '/usr/local/libexec/liuqin-mipps-auth'
    if args.cold_attach_auth:
        # The stock gauge service runs even on DCP, also before role-first PD.
        subprocess.run([sys.executable, helper, '--battery-auth-only'], check=True, timeout=80)
        if not glob.glob('/sys/class/typec/port*-partner'):
            return 0
        os.execl(sys.executable, sys.executable, helper, '--role-first', '--no-data-role-swap', '--timeout', '4')
    ready_file = Path('/run/liuqin-charge-thermal/ready')
    ready_file.parent.mkdir(mode=0o755, exist_ok=True)
    ready_file.unlink(missing_ok=True)
    previous = None
    worker = None
    last_attach = None
    last_log = None
    # The stock monitor starts in tier zero and applies rising thresholds.
    # Its clearing thresholds apply only after a higher tier was entered.
    stage = 0
    # The desktop needs no periodic thermal polling when external power is
    # absent. Open the event channel before the first online read.
    events = socket.socket(socket.AF_NETLINK, socket.SOCK_DGRAM, 15)
    events.bind((0, 1))
    def stop(_signum, _frame):
        raise SystemExit(0)
    signal.signal(signal.SIGTERM, stop)
    try:
        while True:
            try:
                online = read_int(USB/'online') == 1
            except (OSError, ValueError):
                online = False
            if not online:
                ready_file.unlink(missing_ok=True)
                stop_auth(worker)
                worker = None
                previous = last_attach = None
                stage = 0
                # A transition racing the online read is already queued.
                events.recv(65536)
                continue
            level = 15
            observation = None
            try:
                observation = virtual_temperature(temperatures())
                stage = tier(stage, observation)
                level = (ON if screen_on() else OFF)[stage]
            except (OSError, ValueError):
                # Keep the last valid hysteresis state. A missing reading
                # still requests level 15 and clears authentication readiness.
                pass
            applied = False
            try:
                vote = single('/sys/devices/platform/pmic-glink/*/xiaomi/thermal_level_requested')
                try:
                    requested = read_int(vote)
                except OSError:
                    requested = -1
                if requested != level:
                    vote.write_text(str(level)+'\n')
                applied = read_int(vote) == level
            except (OSError, ValueError):
                pass
            state = (stage, level, applied, observation is not None)
            if state != last_log:
                print('stock battery cooling stage=%d level=%d ack=%s virtual_mC=%s' %
                      (stage, level, applied, observation), flush=True)
                last_log = state
            if applied and observation is not None:
                if not ready_file.exists():
                    ready_file.touch()
                    if not args.charger_only:
                        subprocess.run(['systemctl', '--no-block', 'start', 'liuqin-mipps-battery-auth.service',
                                        'liuqin-mipps-auth.service'], check=True, timeout=5)
            else:
                ready_file.unlink(missing_ok=True)
            if args.charger_only:
                try:
                    partner = single('/sys/class/typec/port*-partner')
                    stat = partner.stat()
                    # The kernel allocates a new partner kobject on reattach.
                    attach = (stat.st_dev, stat.st_ino)
                except (OSError, ValueError):
                    # Legacy DCP has no Type-C partner identity; it still gets
                    # gauge authentication once for this powered interval.
                    attach = 'powered-without-partner'
                if attach != previous:
                    stop_auth(worker)
                    worker = None
                    last_attach = None
                    previous = attach
                if attach and applied and observation is not None and attach != last_attach:
                    # The shipping helper authenticates both gauges before the
                    # adapter. It waits for SNK_Ready and validates this attach.
                    worker = subprocess.Popen([sys.executable, __file__, '--cold-attach-auth'],
                                              start_new_session=True, stdout=subprocess.DEVNULL,
                                              stderr=subprocess.DEVNULL)
                    last_attach = attach
            time.sleep(2)
    finally:
        events.close()
        ready_file.unlink(missing_ok=True)
        stop_auth(worker)
    return 0


if __name__ == '__main__':
    sys.exit(main())
