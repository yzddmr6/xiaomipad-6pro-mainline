# Xiaomi MiPPS charger and fuel-gauge authentication for Linux.
#
# Derived from xiaomi-mipps-auth by ianchb
# (https://github.com/ianchb/xiaomi-mipps-auth), written for the Xiaomi Pad
# 6S Pro and also shipped by Armbian.  Original authorship and licence are
# retained.
#
# Adapted for liuqin (Xiaomi Pad 6 Pro) by xiaoabiao
# (https://github.com/yzddmr6/xiaomipad-6pro-mainline/pull/7): renamed state
# paths and unit, and the --allow-unverified-adapter switch for standard PPS
# adapters.  The switch's cable capability gate was added on integration.
#
# The role-first sequence (--role-first) and the Android 7 -> 6 completion were
# validated on liuqin hardware in November 2026 with an original Xiaomi 67 W
# MDY-15-EQ adapter and with a Cuktech unit that implements the same protocol;
# see docs/FASTCHARGE.md.

import argparse
import glob
import hashlib
import hmac
import os
import pwd
import random
import secrets
import signal
import shlex
import subprocess
import sys
import time


