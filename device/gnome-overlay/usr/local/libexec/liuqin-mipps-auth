XIAOMI_SVID = 0x2717
FAST_CHARGE_NOTIFICATION_TITLE = "Fast charge active"
NOTIFICATION_STATE_FILE = "/run/liuqin-mipps-auth/last-notification"
CHARGE_PROFILE_STATE_FILE = "/run/liuqin-mipps-auth/charge-profile"
USB_ONLINE_STATE_FILE = "/run/liuqin-mipps-auth/usb-online"
VERIFIED_STATE_FILE = "/run/liuqin-mipps-auth/verified-attach"
ACTIVE_ATTACH = None
AUTH_ATTEMPTS = 3
SYSTEMD_UNIT = "liuqin-mipps-auth.service"
INITIAL_READY_POLL_SECONDS = 8
ROLE_REQUEST_TIMEOUT = 8
ROLE_REQUEST_DELAY = 0.07
ANDROID_CMD_SETTLE = {
    1: 0.005,
    2: 0.005,
    3: 0.005,
    4: 0.500,
    5: 0.500,
    6: 0.005,
}


class UnsupportedChargerError(Exception):
    pass


def find_xiaomi_dir():
    candidates = ["/sys/class/qcom-battery"]
    candidates += glob.glob("/sys/devices/platform/pmic-glink/*/xiaomi")
    for path in candidates:
        if os.path.exists(os.path.join(path, "request_vdm_cmd")):
            return path
    raise FileNotFoundError("request_vdm_cmd sysfs node not found")


def read_node(root, name):
    with open(os.path.join(root, name), "r", encoding="ascii", errors="ignore") as f:
        return f.read().strip().replace("\x00", "")


def write_node(root, name, value):
    with open(os.path.join(root, name), "w", encoding="ascii") as f:
        f.write(value)
        if not value.endswith("\n"):
            f.write("\n")


def write_node_if_present(root, name, value):
    path = os.path.join(root, name)
    if os.path.exists(path):
        write_node(root, name, value)
        return True
    return False


def find_power_supply(*names):
    for name in names:
        path = os.path.join("/sys/class/power_supply", name)
        if os.path.exists(path):
            return path
    return None


def usb_is_online():
    path = find_power_supply("qcom-battmgr-usb", "usb")
    if not path:
        print("warning: USB power_supply node not found", file=sys.stderr)
        return False

    try:
        return read_node(path, "online") == "1"
    except OSError as e:
        print(f"warning: failed to read {path}/online: {e}", file=sys.stderr)
        return False


def wait_usb_online(timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        if usb_is_online():
            return True
        time.sleep(0.05)
    return usb_is_online()


def find_typec_port():
    for path in glob.glob("/sys/class/typec/port*"):
        if os.path.exists(os.path.join(path, "data_role")):
            return path
    return None


def unverified_adapter_allowed(root):
    # USB PD TD.PD.SRC3.E22 requires sources to limit their advertisement
    # to the cable rating. liuqin adsp.b14 dpm_request_pd_contract_update
    # (0x601810c8..0x60181120) skips APDOs outside the requested voltage
    # range or with (APDO & 0x7f) * 50 mA below the requested current.
    # Only matching entries reach PPS RDO construction at 0x60181128.
    real_type = current_string_value(root, "real_type")
    state = current_string_value(root, "current_state")
    return (real_type == "PD_PPS" and state == "SNK_Ready" and not should_skip_pdo2(root),
            f"real_type={real_type} current_state={state}")


def current_attach_token():
    for path in sorted(glob.glob("/sys/class/typec/port*-partner")):
        try:
            st = os.stat(path)
        except OSError:
            continue
        return f"{os.path.basename(path)}:{st.st_dev}:{st.st_ino}:{st.st_ctime_ns}"
    return None


def read_state_file(path):
    try:
        with open(path, "r", encoding="ascii", errors="ignore") as f:
            return f.read().strip()
    except FileNotFoundError:
        return None
    except OSError as e:
        print(f"warning: failed to read {path}: {e}", file=sys.stderr)
        return None


def write_state_file(path, value):
    try:
        directory = os.path.dirname(path)
        if directory:
            os.makedirs(directory, exist_ok=True)
        with open(path, "w", encoding="ascii") as f:
            f.write(value)
            f.write("\n")
    except OSError as e:
        print(f"warning: failed to write {path}: {e}", file=sys.stderr)


def start_systemd_unit(unit):
    systemctl = "/usr/bin/systemctl" if os.path.exists("/usr/bin/systemctl") else "systemctl"
    subprocess.run([systemctl, "--no-block", "start", unit],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   timeout=2, check=True)


def parse_power_watts(value):
    try:
        power = int(value.strip(), 0)
    except ValueError:
        return None

    if power <= 0:
        return None
    return power


def parse_int(value):
    try:
        return int(value.strip(), 0)
    except ValueError:
        return None


def current_int_value(root, name):
    path = os.path.join(root, name)
    if not os.path.exists(path):
        return None
    try:
        return parse_int(read_node(root, name))
    except OSError as e:
        print(f"warning: failed to read {path}: {e}", file=sys.stderr)
        return None


def current_string_value(root, name):
    path = os.path.join(root, name)
    if not os.path.exists(path):
        return None
    try:
        return read_node(root, name).strip()
    except OSError as e:
        print(f"warning: failed to read {path}: {e}", file=sys.stderr)
        return None


def current_battery_capacity():
    battery = find_power_supply("qcom-battmgr-bat", "battery")
    if not battery:
        return None
    return current_int_value(battery, "capacity")


def current_power_max_watts(root):
    path = os.path.join(root, "power_max")
    if not os.path.exists(path):
        return None
    try:
        return parse_power_watts(read_node(root, "power_max"))
    except OSError as e:
        print(f"warning: failed to read {path}: {e}", file=sys.stderr)
        return None


def gvariant_string(value):
    return "'" + value.replace("\\", "\\\\").replace("'", "\\'") + "'"


def notify_session_bus(bus, uid, title, body):
    env = os.environ.copy()
    env["DBUS_SESSION_BUS_ADDRESS"] = f"unix:path={bus}"
    env["XDG_RUNTIME_DIR"] = os.path.dirname(bus)

    def drop_privileges():
        if os.geteuid() != 0:
            return
        entry = pwd.getpwuid(uid)
        os.setgid(entry.pw_gid)
        os.setuid(uid)

    cmd = [
        "gdbus", "call", "--session",
        "--dest", "org.freedesktop.Notifications",
        "--object-path", "/org/freedesktop/Notifications",
        "--method", "org.freedesktop.Notifications.Notify",
        gvariant_string("liuqin-mipps-auth"),
        "0",
        gvariant_string("battery-good-symbolic"),
        gvariant_string(title),
        gvariant_string(body),
        "[]",
        "{}",
        "5000",
    ]
    subprocess.run(cmd, env=env, preexec_fn=drop_privileges,
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                   timeout=2, check=True)


def pd_verified(root):
    path = os.path.join(root, "pd_verifed")
    if not os.path.exists(path):
        return False
    try:
        return read_node(root, "pd_verifed").strip() == "1"
    except OSError:
        return False


def charge_mode_body(mode, watts):
    if mode == "MiPPS":
        return f"MiPPS enabled at {watts}W"
    if mode == "PD":
        return "PD enabled"
    return f"PPS enabled at {watts}W"


def current_charge_profile(root, pd_auth):
    capacity = current_battery_capacity()
    if capacity is None or capacity >= 95:
        return None

    watts = current_power_max_watts(root)
    if not watts:
        return None

    fastchg_mode = current_int_value(root, "fastchg_mode")
    real_type = current_string_value(root, "real_type")
    fastchg_active = fastchg_mode is None or fastchg_mode > 0

    if pd_auth:
        return "MiPPS", watts

    if real_type == "PD_PPS":
        return "PPS", watts

    if real_type == "PD":
        if not fastchg_active:
            return "PD", watts
        return "PPS", watts

    return None


def wait_charge_profile(root, pd_auth, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        profile = current_charge_profile(root, pd_auth)
        if profile:
            return profile
        time.sleep(0.1)
    return current_charge_profile(root, pd_auth)


def charge_profile_notification_key(profile):
    attach_token = current_attach_token() or "no-typec-partner"
    mode, watts = profile
    return f"{attach_token}:{mode}:{watts}"


def write_charge_profile(profile):
    if not profile:
        write_state_file(CHARGE_PROFILE_STATE_FILE, "none")
        return
    mode, _ = profile
    write_state_file(CHARGE_PROFILE_STATE_FILE, mode)


def notify_charge_profile(root, pd_auth, state_file, timeout=2.0):
    profile = wait_charge_profile(root, pd_auth, timeout)
    write_charge_profile(profile)
    if not profile:
        print("fast_charge_notification=none")
        write_state_file(state_file, "none")
        return False

    mode, watts = profile
    key = charge_profile_notification_key(profile)
    if read_state_file(state_file) == key:
        print(f"fast_charge_notification=skipped:{mode}:{watts}W")
        return False

    body = charge_mode_body(mode, watts)
    sent = False
    for bus in sorted(glob.glob("/run/user/[0-9]*/bus")):
        try:
            st = os.stat(bus)
            notify_session_bus(bus, st.st_uid,
                               FAST_CHARGE_NOTIFICATION_TITLE, body)
            sent = True
        except (KeyError, OSError, subprocess.SubprocessError) as e:
            print(f"warning: failed to send notification on {bus}: {e}",
                  file=sys.stderr)

    if sent:
        write_state_file(state_file, key)
        if mode == "PD":
            print("fast_charge_notification=PD")
        else:
            print(f"fast_charge_notification={mode}:{watts}W")
    else:
        print("warning: no desktop session accepted fast charge notification",
              file=sys.stderr)
    return sent


def notify_completed_charge(root, state_file, pd_auth=None, timeout=2.0):
    if pd_auth is None:
        pd_auth = pd_verified(root)
    return notify_charge_profile(root, pd_auth, state_file, timeout)


def wait_real_type(root, timeout):
    deadline = time.monotonic() + timeout
    last = "Unknown"
    while time.monotonic() < deadline:
        try:
            last = read_node(root, "real_type")
        except OSError:
            return "Unknown"
        if last and last != "Unknown":
            return last
        time.sleep(0.05)
    return last


def ensure_typec_host(timeout):
    port = find_typec_port()
    if not port:
        print("warning: no Type-C data_role node found", file=sys.stderr)
        return False

    path = os.path.join(port, "data_role")
    try:
        role = read_node(port, "data_role")
    except OSError as e:
        print(f"warning: failed to read {path}: {e}", file=sys.stderr)
        return False

    if role.startswith("[host]") or "[host]" in role.split():
        print(f"typec_data_role={role}")
        return True

    try:
        write_node(port, "data_role", "host")
    except OSError as e:
        print(f"warning: failed to request Type-C host role: {e}", file=sys.stderr)
        return False

    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        role = read_node(port, "data_role")
        if role.startswith("[host]") or "[host]" in role.split():
            print(f"typec_data_role={role}")
            return True
        time.sleep(0.05)

    print(f"warning: timed out waiting for Type-C host role, last={role}", file=sys.stderr)
    return False


def wait_source_ready(root, previous_type=None):
    # Only poll quickly during initial negotiation. Some docks publish a PD
    # contract much later, without generating another USB online edge.
    deadline = time.monotonic() + INITIAL_READY_POLL_SECONDS
    previous = None
    while True:
        require_current_attach()
        contract = (current_string_value(root, "real_type"),
                    current_string_value(root, "current_state"))
        pdo_pending = contract[0] == "PD_PPS" and should_skip_pdo2(root)
        ready = contract[0] in ("PD", "PD_PPS") and contract[1] == "SNK_Ready"
        # An SPR PPS source advertises the mandatory fixed 5 V PDO and an
        # APDO. A zero PDO2 can precede publication of the capabilities.
        if ready and not pdo_pending and contract[0] != previous_type:
            return contract[0]
        if (contract, pdo_pending) != previous:
            print(f"role_first=waiting real_type={contract[0]} current_state={contract[1]} "
                  f"pdo_pending={pdo_pending}")
            previous = contract, pdo_pending
        time.sleep(0.1 if time.monotonic() < deadline else INITIAL_READY_POLL_SECONDS)


def request_host_data_role(port, timeout):
    """Ask the Type-C port for the host data role, as the stock system does
    while a Xiaomi adapter is attached.

    The role attribute is written without a trailing newline so the sysfs store
    receives exactly `host`.
    """
    command = f"printf host > {shlex.quote(os.path.join(port, 'data_role'))}"
    try:
        result = subprocess.run(["/bin/sh", "-c", command], text=True,
                                capture_output=True, timeout=timeout)
        return result.returncode, result.stderr.strip()
    except (OSError, subprocess.SubprocessError) as e:
        return 1, str(e)


def require_current_attach():
    if not ACTIVE_ATTACH or not usb_is_online() or current_attach_token() != ACTIVE_ATTACH:
        raise UnsupportedChargerError("Type-C attach changed during authentication")


def clear_verdict(root):
    write_node_if_present(root, "pd_verifed", "0")
    write_state_file(VERIFIED_STATE_FILE, "none")


def role_first_prelude(root):
    """Request host before UVDMs for a Xiaomi partner only."""
    require_current_attach()

    adapter_svid = current_adapter_svid(root)
    if adapter_svid != XIAOMI_SVID:
        shown = "unknown" if adapter_svid is None else f"0x{adapter_svid:04x}"
        print(f"role_first=skipped_non_xiaomi adapter_svid={shown}")
        return

    # The fuel gauges must be authenticated before the charger handshake; the
    # boot unit normally does this already, so this repeats it only if the run
    # missed it (for example after a reboot without an adapter).
    if not (node_is_one(root, "authentic") and node_is_one(root, "slave_authentic")):
        enable_battery_auth(root)

    require_current_attach()
    port = find_typec_port()
    if not port:
        raise UnsupportedChargerError("no Type-C port for host role")
    role = read_node(port, "data_role")

    if "[host]" not in role:
        time.sleep(ROLE_REQUEST_DELAY)
        require_current_attach()
        print("role_request=begin")
        returncode, stderr = request_host_data_role(port, ROLE_REQUEST_TIMEOUT)
        try:
            role = read_node(port, "data_role")
        except OSError:
            role = ""
        print(f"role_request=end returncode={returncode} role={role} "
              f"stderr={stderr}")
        if returncode or "[host]" not in role:
            raise UnsupportedChargerError("host role request failed")

    require_current_attach()
    print("role_first=proceed")


def vdm_state(root):
    text = read_node(root, "request_vdm_cmd")
    state, _, payload = text.partition(",")
    return int(state), payload.strip()


def wait_state(root, expected, timeout):
    deadline = time.monotonic() + timeout
    last = None
    while time.monotonic() < deadline:
        require_current_attach()
        last = vdm_state(root)
        if last[0] == expected:
            return last
        time.sleep(0.02)
    raise UnsupportedChargerError(f"timed out waiting for VDM state {expected}, last={last}")


def send_vdm(root, cmd, payload="null", timeout=2.0, wait=True, settle=0.0):
    require_current_attach()
    write_node(root, "request_vdm_cmd", f"{cmd},{payload}")
    if not wait:
        time.sleep(settle)
        require_current_attach()
        return vdm_state(root)
    state = wait_state(root, cmd, timeout)
    if settle:
        time.sleep(settle)
        state = vdm_state(root)
    return state


def normalize_adapter_id(adapter_id):
    adapter_id = adapter_id.strip().lower()[:8]
    if len(adapter_id) == 8 and adapter_id != "00000000":
        bytes.fromhex(adapter_id)
        return adapter_id
    return None


def normalize_adapter_svid(adapter_svid):
    adapter_svid = adapter_svid.strip().lower()
    if not adapter_svid:
        return None
    try:
        return int(adapter_svid.split()[0], 16)
    except ValueError:
        return None


def current_adapter_svid(root):
    try:
        return normalize_adapter_svid(read_node(root, "adapter_svid"))
    except OSError:
        return None


def detect_adapter_id(root, timeout):
    deadline = time.monotonic() + timeout
    while time.monotonic() < deadline:
        try:
            adapter_id = normalize_adapter_id(read_node(root, "adapter_id"))
            if adapter_id:
                return adapter_id
        except (FileNotFoundError, ValueError):
            pass
        time.sleep(0.05)
    return None


def should_skip_pdo2(root):
    try:
        pdo2 = read_node(root, "pdo2").strip().lower()
    except OSError:
        return False
    return len(pdo2) >= 8 and pdo2[:8] == "00000000"


def auth_already_completed(root, token, allow_unverified):
    if not pd_verified(root):
        return False
    if not all(node_is_one(root, gauge) for gauge in ("authentic", "slave_authentic")):
        return False
    proof = read_state_file(VERIFIED_STATE_FILE)
    if proof == f"pps {token}":
        return allow_unverified and unverified_adapter_allowed(root)[0]
    return proof == f"mipps {token}" and vdm_state(root)[0] in (6, 7)


def print_status(root):
    for name in ("request_vdm_cmd", "authentic", "slave_authentic",
                 "adapter_svid", "adapter_id", "apdo_max",
                 "power_max", "fastchg_mode", "quick_charge_type",
                 "pps_ptf", "pd_verifed",
                 "bq2597x_bus_voltage", "bq2597x_bus_current",
                 "bq2597x_slave_bus_current"):
        value = current_string_value(root, name)
        if value is not None:
            print(f"{name}={value}")


def node_is_one(root, name):
    path = os.path.join(root, name)
    return os.path.exists(path) and read_node(root, name).strip() == "1"


def verify_fuel_gauge_once(root, slave):
    flag = "1" if slave else "0"
    result_node = "slave_authentic" if slave else "authentic"
    challenge = secrets.token_hex(32)

    write_node(root, "verify_slave_flag", flag)
    write_node(root, "verify_digest", challenge)
    time.sleep(1.4)

    bq_digest = read_node(root, "verify_digest")[:64].lower()
    expected = [
        hmac.new(bytes.fromhex(key), bytes.fromhex(challenge),
                 hashlib.sha256).hexdigest()
        for key in FG_KEYS
    ]
    ok = bq_digest in expected
    write_node_if_present(root, result_node, "1" if ok else "0")
    return ok


def verify_fuel_gauge(root, slave, required=True, retries=10):
    result_node = "slave_authentic" if slave else "authentic"

    if node_is_one(root, result_node):
        print(f"{result_node}_verified=1")
        return True

    for attempt in range(1, retries + 1):
        if verify_fuel_gauge_once(root, slave):
            print(f"{result_node}_verified=1")
            return True
        time.sleep(0.2)

    print(f"{result_node}_verified=0")
    if required:
        raise RuntimeError(f"{result_node} digest verification failed after {retries} attempts")
    print(f"warning: {result_node} digest verification failed", file=sys.stderr)
    return False


def enable_battery_auth(root):
    if not os.path.exists(os.path.join(root, "verify_digest")):
        raise FileNotFoundError("verify_digest sysfs node not found")

    verify_fuel_gauge(root, False, required=True)
    verify_fuel_gauge(root, True, required=True)
    time.sleep(0.5)


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("--sysfs", help="directory containing request_vdm_cmd")
    parser.add_argument("--seed-index", type=int, choices=range(10), help="fixed seed index for repeatable tests")
    parser.add_argument("--battery-auth-only", action="store_true",
                        help="verify both fuel gauges without adapter commands")
    parser.add_argument("--no-data-role-swap", action="store_true",
                        help="do not request Type-C host data role before Xiaomi UVDM auth")
    parser.add_argument("--role-first", action="store_true",
                        help="wait for the source to be ready, take the host data role for a "
                             "Xiaomi adapter and authenticate the current Type-C attach; validated "
                             "sequence for MiPPS fast charging")
    parser.add_argument("--allow-unverified-adapter", action=argparse.BooleanOptionalAction, default=True,
                        help="assert pd_verifed even when adapter authentication fails, "
                             "which enables standard PPS fast charging on third-party "
                             "adapters that cannot pass Xiaomi's private authentication")
    parser.add_argument("--force", action="store_true", help=argparse.SUPPRESS)
    parser.add_argument("--skip-completed", action="store_true",
                        help="deprecated; completed handshakes are skipped unless --force is used")
    parser.add_argument("--once-per-attach", action="store_true",
                        help="attempt authentication at most once for the current Type-C partner attach")
    parser.add_argument("--state-file", default="/run/liuqin-mipps-auth/last-attach",
                        help="state file used by --once-per-attach")
    parser.add_argument("--clear-notification", action="store_true",
                        help=argparse.SUPPRESS)
    parser.add_argument("--usb-online-trigger", action="store_true",
                        help=argparse.SUPPRESS)
    parser.add_argument("--timeout", type=float, default=2.0)
    args = parser.parse_args()

    if args.clear_notification:
        clear_verdict(args.sysfs or find_xiaomi_dir())
        write_state_file(NOTIFICATION_STATE_FILE, "none")
        write_state_file(CHARGE_PROFILE_STATE_FILE, "none")
        write_state_file(USB_ONLINE_STATE_FILE, "0")
        print("fast_charge_notification_state=cleared")
        return

    if args.usb_online_trigger:
        if read_state_file(USB_ONLINE_STATE_FILE) == "1":
            print("usb_online_trigger=skipped")
            return
        start_systemd_unit(SYSTEMD_UNIT)
        write_state_file(USB_ONLINE_STATE_FILE, "1")
        print("usb_online_trigger=started")
        return

    root = args.sysfs or find_xiaomi_dir()
    global ACTIVE_ATTACH
    if args.battery_auth_only:
        # Clear stale firmware state before the boot/charger-only gauge pass.
        clear_verdict(root)
        enable_battery_auth(root)
        print("battery_auth_only=completed")
        return

    while True:
        ACTIVE_ATTACH = current_attach_token()
        if not ACTIVE_ATTACH or not usb_is_online():
            clear_verdict(root)
            print("usb_online=0 or no Type-C partner")
            return
        keep_verdict = False
        try:
            if not args.force and auth_already_completed(root, ACTIVE_ATTACH, args.allow_unverified_adapter):
                keep_verdict = True
                print("MiPPS auth sequence already completed for this attach")
            else:
                clear_verdict(root)
                keep_verdict = authenticate_attach(root, args)
        except UnsupportedChargerError as e:
            print(f"auth_stopped={e}")
        finally:
            if not (keep_verdict and usb_is_online() and current_attach_token() == ACTIVE_ATTACH):
                clear_verdict(root)
        # The add/online uevent for a replacement may have been coalesced
        # by systemd while the old handshake was still running.
        if current_attach_token() == ACTIVE_ATTACH or not usb_is_online():
            return


def authenticate_attach(root, args):
    if args.once_per_attach:
        if read_state_file(args.state_file) == ACTIVE_ATTACH:
            print("MiPPS auth skipped: already attempted for current Type-C attach")
            return False
        write_state_file(args.state_file, ACTIVE_ATTACH)

    if not args.role_first:
        return authenticate(root, args, last_attempt=True)

    # A fixed PD contract may be followed by PPS without a new attachment.
    # Wait for that change without repeating handshakes against stable PD.
    attempts = 1 if args.once_per_attach else AUTH_ATTEMPTS
    previous_type = None
    while True:
        contract = wait_source_ready(root, previous_type)
        for attempt in range(1, attempts + 1):
            try:
                role_first_prelude(root)
                args.no_data_role_swap = True
                if authenticate(root, args, last_attempt=attempt == attempts):
                    return True
                break
            except (UnsupportedChargerError, OSError, RuntimeError, ValueError) as e:
                print(f"auth_attempt={attempt}/{attempts} failed: {e}", file=sys.stderr)
                require_current_attach()
                if attempt < attempts:
                    time.sleep(2 ** (attempt - 1))
                    contract = wait_source_ready(root)
        if contract != "PD" or args.once_per_attach:
            return False
        previous_type = contract


def authenticate(root, args, last_attempt):
    require_current_attach()
    if not wait_usb_online(args.timeout):
        print("usb_online=0")
        write_state_file(NOTIFICATION_STATE_FILE, "none")
        write_state_file(CHARGE_PROFILE_STATE_FILE, "none")
        write_state_file(USB_ONLINE_STATE_FILE, "0")
        return
    write_state_file(USB_ONLINE_STATE_FILE, "1")

    seed_index = args.seed_index if args.seed_index is not None else random.randrange(len(SEEDS))
    print(f"sysfs={root}")
    print(f"real_type={wait_real_type(root, args.timeout)}")
    print(f"seed_index={seed_index}")

    require_current_attach()
    if not args.no_data_role_swap and not ensure_typec_host(args.timeout):
        return False

    adapter_svid = current_adapter_svid(root)
    if adapter_svid is None:
        print("adapter_svid=unknown")
    else:
        print(f"adapter_svid=0x{adapter_svid:04x}")
        if adapter_svid != XIAOMI_SVID:
            print(
                "warning: adapter_svid is not Xiaomi; continuing because "
                "firmware may expose a stale SVID after detach",
                file=sys.stderr)

    enable_battery_auth(root)

    # Adapter authentication is best-effort: a non-Xiaomi PPS adapter may
    # ignore the UVDM handshake entirely.  That must not abort the run,
    # otherwise --allow-unverified-adapter can never assert the gate for
    # exactly the adapters it was added for.
    pd_auth = False
    auth = ""
    adapter_id = None
    digest = ""
    challenge = secrets.token_hex(16)
    print(f"challenge={challenge}")
    try:
        if should_skip_pdo2(root):
            raise UnsupportedChargerError("pdo2 reports no source PDO for adapter authentication")
        send_vdm(root, 1, timeout=args.timeout, settle=ANDROID_CMD_SETTLE[1])
        send_vdm(root, 2, timeout=args.timeout, settle=ANDROID_CMD_SETTLE[2])
        send_vdm(root, 3, timeout=args.timeout, settle=ANDROID_CMD_SETTLE[3])
        send_vdm(root, 4, SEEDS[seed_index], timeout=args.timeout,
                 settle=ANDROID_CMD_SETTLE[4])
        _, auth = send_vdm(root, 5, challenge, timeout=args.timeout,
                           settle=ANDROID_CMD_SETTLE[5])
        adapter_id = detect_adapter_id(root, args.timeout)
    except (UnsupportedChargerError, OSError) as e:
        print(f"warning: adapter authentication unavailable: {e}",
              file=sys.stderr)

    if adapter_id:
        digest = hmac.new(bytes.fromhex(KEYS[seed_index]),
                          bytes.fromhex(challenge + adapter_id),
                          hashlib.sha256).hexdigest()
        pd_auth = auth.lower()[:32] == digest[:32]
        if not pd_auth:
            print(
                f"adapter auth mismatch: seed_index={seed_index} adapter_id={adapter_id} "
                f"expected={digest[:32]} charger={auth[:32]}",
                file=sys.stderr)
        print(f"adapter_id={adapter_id}")
    else:
        print("adapter_id=unavailable")

    require_current_attach()
    if not pd_auth and not last_attempt:
        raise UnsupportedChargerError("adapter handshake did not authenticate")

    pd_auth_payload = "01000000" if pd_auth else "00000000"
    if adapter_id:
        # Android: 7 = REMOVE_COMPENSATION, 6 = VERIFIED.
        require_current_attach()
        send_vdm(root, 7, pd_auth_payload, timeout=args.timeout, wait=False,
                 settle=0.1)
        require_current_attach()
        send_vdm(root, 6, pd_auth_payload, timeout=args.timeout, wait=False,
                 settle=0.02)
        print("adapter_sequence=android:7,6")
    else:
        print("adapter_auth_result=skipped")

    require_current_attach()
    gate = False
    # pd_verifed is the firmware's gate on the high-voltage charge path and
    # is normally the outcome of the adapter authentication above.  Adapters
    # without Xiaomi protocol support cannot compute the expected digest, so
    # pd_auth stays 0 and plain PPS fast charging never engages even though
    # PPS itself negotiated fine. The standard PPS fallback still requires
    # both battery gauges and a ready PPS contract on this attachment.
    if os.path.exists(os.path.join(root, "pd_verifed")):
        gate = pd_auth
        if not pd_auth and args.allow_unverified_adapter:
            gate, reason = unverified_adapter_allowed(root)
            print(f"unverified_adapter={'allowed' if gate else 'refused'}: {reason}")
        require_current_attach()
        write_node(root, "pd_verifed", "1" if gate else "0")
        if gate and not pd_auth:
            print("pd_verifed=1 (adapter authentication bypassed on request)")

    print(f"pd_auth={1 if pd_auth else 0}")
    print("MiPPS auth sequence completed")
    print_status(root)
    # The notification reports the real profile: MiPPS only when Xiaomi
    # authentication succeeded, otherwise PPS/PD as negotiated.
    notify_completed_charge(root, NOTIFICATION_STATE_FILE, pd_auth)
    require_current_attach()
    if gate:
        write_state_file(VERIFIED_STATE_FILE, f"{'mipps' if pd_auth else 'pps'} {ACTIVE_ATTACH}")
    return gate


if __name__ == "__main__":
    def interrupted(signum, _frame):
        raise SystemExit(128 + signum)
    signal.signal(signal.SIGTERM, interrupted)
    signal.signal(signal.SIGINT, interrupted)
    try:
        main()
    except UnsupportedChargerError as e:
        print(f"MiPPS auth skipped: {e}")
        sys.exit(0)
    except Exception as e:
        print(f"error: {e}", file=sys.stderr)
        sys.exit(1)
