#!/bin/sh
# SPDX-License-Identifier: MIT
#
# liuqin-switch -- rotate the Android and Ubuntu boot images through boot_a
# on the Xiaomi Pad 6 Pro (liuqin, SM8475).
#
# Both systems boot from slot A.  Switching writes the other system's boot
# image into boot_a and reboots; the image that is not installed lives as a
# file in a store on the Ubuntu root filesystem.  Slot switching is not an
# option on this bootloader: the stock ABL couples the slot attribute bits to
# a type-GUID swap on every _a/_b pair and to the UFS boot LUN, and anything
# short of all three leaves every image failing LoadImageAndAuth.
#
# Only boot_a is ever written.  Not the slot attributes, not the type GUIDs,
# not the UFS boot LUN, not vbmeta, misc, recovery or anything in slot B.
# boot_b keeps a copy of the Ubuntu boot image that the bootloader falls back
# to on its own when boot_a does not load; nothing here writes it.
#
# Identification rule (header fields only; the switcher cannot look inside a
# ramdisk):
#   ubuntu  "ANDROID!" magic, header_version 2, page_size 4096,
#           header_size 1660, dtb_size > 0, kernel_size > 0 -- the project's
#           self-contained v2 image, which carries its own DTB
#   android "ANDROID!" magic, header_version 3 with header_size 1580, or
#           header_version 4 with header_size 1584, kernel_size > 0 -- the
#           stock GKI boot image and a KernelSU-patched copy of it
#   unknown anything else, including an erased partition
#
# Safety rules, in the order they apply:
#   * a set whose boot.img is missing, does not match its SHA256SUMS, is
#     larger than boot_a or is not of its own kind is refused before any write;
#   * no switch starts without a verified way back: to-android needs a usable
#     Ubuntu set, to-ubuntu needs the live Android image archived in the store;
#   * an image that identifies as ours is never archived as Android;
#   * boot_a is written whole (image plus zero fill), synced, flushed from the
#     page cache, read back and compared; a mismatch rewrites the other set
#     and exits non-zero without rebooting;
#   * hangup, interrupt and terminate are ignored while boot_a is being
#     written, verified or restored (children inherit that), so no signal can
#     leave it half-written; SIGKILL and power loss still can, which is what
#     the fallback copy in boot_b is for;
#   * the kernel read-only flag of boot_a and of its disk is cleared only for
#     the write and restored on every exit path.
#
# Runs on both systems, so it stays POSIX sh and uses only what dash with
# coreutils, BusyBox and Android's mksh with toybox all provide.  Arithmetic
# stays below 2^31 because mksh is 32-bit.  Ubuntu: sudo or pkexec.  Android:
# a KernelSU root shell, which mounts linux_root read-only for the duration
# (its 5.10 kernel cannot mount this ext4 read-write), so Android never writes
# the store.

set -u

. "$(dirname -- "$0")/switch-common.sh"
umask 022

PROG=liuqin-switch
BOOT_LABEL=boot_a
BOOT_BYTES_PINNED=201326592
ROOT_LABEL=linux_root
ROOT_SUBDIR=native-root
STORE_DEFAULT=/var/lib/liuqin/switch
MOUNTPOINT=/mnt/liuqin-switch

STORE=
STORE_RO=0
DEV_DIR=
DRY_RUN=0
NO_REBOOT=0
MOUNTED_HERE=0
LOG_FILE=
LOCK_DIR=
LOCKED=0
BOOT_DEV=
BOOT_BYTES=
RUNNING_SLOT=
LIVE_FULL=
LIVE_CLASS=
RW_ARMED=0
RW_PART=
RW_PART_WAS=
RW_DISK=
RW_DISK_WAS=
RW_FAILED=0
rb_saved=0
write_started=0

# ---------------------------------------------------------------------------
# Output.  Nothing below may call die() from inside a command substitution:
# that would only leave the subshell, and its cleanup would run twice.

log() {
	if [ -z "$DEV_DIR" ] && ! is_android; then logger -t "$PROG" -- "$*"; fi
	[ -n "$LOG_FILE" ] || return 0
	printf '%s %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo unknown)" "$*" \
		>>"$LOG_FILE" 2>/dev/null || :
}

say() {
	printf '%s\n' "$*"
	log "$*"
}

warn() {
	printf '%s: %s\n' "$PROG" "$*" >&2
	log "WARNING $*"
}

die() {
	printf '%s: %s\n' "$PROG" "$*" >&2
	log "ERROR $*"
	switch_notify_failure "$*"
	exit 1
}

# ---------------------------------------------------------------------------
# Environment

is_android() { [ -z "$DEV_DIR" ] && [ -f /system/build.prop ]; }

# Same parser as initramfs/init: both spellings are accepted, they must agree,
# and the value must be _a or _b.  tests/slot-tool.py runs both copies.
slot_from_cmdline() {
	slot_suffix=
	slot_bad=0
	set -f
	for slot_word in $1; do
		case $slot_word in
		androidboot.slot_suffix=*) slot_value=${slot_word#androidboot.slot_suffix=} ;;
		slot_suffix=*) slot_value=${slot_word#slot_suffix=} ;;
		*) continue ;;
		esac
		case $slot_value in
		_a) slot_value=a ;;
		_b) slot_value=b ;;
		*) slot_bad=1; continue ;;
		esac
		[ -z "$slot_suffix" ] || [ "$slot_suffix" = "$slot_value" ] || slot_bad=1
		slot_suffix=$slot_value
	done
	set +f
	[ "$slot_bad" = 0 ] && [ -n "$slot_suffix" ] || { slot_suffix=; return 1; }
	return 0
}

# Which slot this boot came from.  Only used to refuse a switch while running
# on the bootloader's fallback copy in slot B; the target is boot_a either way.
detect_running_slot() {
	RUNNING_SLOT=
	if [ -n "$DEV_DIR" ]; then
		if [ -f "$DEV_DIR/cmdline" ] && slot_from_cmdline "$(cat "$DEV_DIR/cmdline")"; then
			RUNNING_SLOT=$slot_suffix
		fi
		return 0
	fi
	drs_words=$(cat /proc/cmdline 2>/dev/null)
	if is_android && command -v getprop >/dev/null 2>&1; then
		drs_prop=$(getprop ro.boot.slot_suffix)
		[ -z "$drs_prop" ] || drs_words="$drs_words androidboot.slot_suffix=$drs_prop"
	fi
	if [ -r /proc/bootconfig ]; then
		drs_config=$(switch_bootconfig_slots /proc/bootconfig | sed 's/^/androidboot.slot_suffix=/')
		drs_words="$drs_words $drs_config"
	fi
	if slot_from_cmdline "$drs_words"; then RUNNING_SLOT=$slot_suffix; fi
	return 0
}

# Android: /dev/block/by-name.  Ubuntu: /dev/disk/by-partlabel.  Anything else:
# the PARTNAME in the block uevent.
resolve_part() {
	if [ -n "$DEV_DIR" ]; then
		[ -e "$DEV_DIR/$1" ] || return 1
		printf '%s\n' "$DEV_DIR/$1"
		return 0
	fi
	for rp_base in /dev/block/by-name /dev/disk/by-partlabel; do
		if [ -e "$rp_base/$1" ]; then
			readlink -f "$rp_base/$1"
			return 0
		fi
	done
	for rp_uevent in /sys/class/block/*/uevent; do
		[ -e "$rp_uevent" ] || continue
		grep -qx "PARTNAME=$1" "$rp_uevent" 2>/dev/null || continue
		rp_dir=${rp_uevent%/uevent}
		printf '/dev/%s\n' "${rp_dir##*/}"
		return 0
	done
	return 1
}

part_bytes() {
	if [ -n "$DEV_DIR" ]; then
		stat -c %s "$1"
		return
	fi
	pb_bytes=$(blockdev --getsize64 "$1" 2>/dev/null) && [ -n "$pb_bytes" ] &&
		{ printf '%s\n' "$pb_bytes"; return 0; }
	pb_node=${1##*/}
	pb_sectors=$(cat "/sys/class/block/$pb_node/size" 2>/dev/null) || return 1
	printf '%s\n' "$((pb_sectors * 512))"
}

# The whole-disk node a partition belongs to.  Its read-only flag counts too:
# the kernel refuses a partition write when either one is set, and the
# storage guard seals both.
parent_disk() {
	if [ -n "$DEV_DIR" ]; then
		[ -e "$DEV_DIR/sde" ] || return 1
		printf '%s\n' "$DEV_DIR/sde"
		return 0
	fi
	pd_node=${1##*/}
	[ -e "/sys/class/block/$pd_node/partition" ] || return 1
	pd_path=$(readlink -f "/sys/class/block/$pd_node/..") || return 1
	pd_disk=${pd_path##*/}
	[ -n "$pd_disk" ] && [ -e "${1%/*}/$pd_disk" ] || return 1
	printf '%s\n' "${1%/*}/$pd_disk"
}

# ---------------------------------------------------------------------------
# Kernel read-only flag.  The tests model it as a sidecar file and log every
# change, so that "restored on every exit path" is something they can check.

ro_get() {
	if [ -n "$DEV_DIR" ]; then
		cat "$1.ro" 2>/dev/null || echo 0
		return 0
	fi
	blockdev --getro "$1" 2>/dev/null
}

ro_set() { # <node> <0|1>
	if [ -n "$DEV_DIR" ]; then
		# Fault injection: the partition refuses to become writable after
		# its disk already has.
		if [ "$2" = 0 ] && [ "$1" = "$BOOT_DEV" ] && [ -e "$DEV_DIR/.fault-setrw" ]; then
			rm -f "$DEV_DIR/.fault-setrw"
			return 1
		fi
		printf '%s\n' "$2" >"$1.ro" || return 1
		printf '%s %s\n' "${1##*/}" "$2" >>"$DEV_DIR/.ro-log"
		return 0
	fi
	if [ "$2" = 1 ]; then
		run_logged blockdev --setro "$1"
	else
		run_logged blockdev --setrw "$1"
	fi
}

open_rw() {
	RW_PART=$BOOT_DEV
	RW_DISK=$(parent_disk "$BOOT_DEV") || RW_DISK=
	[ -n "$RW_DISK" ] || [ -n "$DEV_DIR" ] ||
		die "cannot find the disk that holds $BOOT_DEV"
	RW_PART_WAS=$(ro_get "$RW_PART")
	case $RW_PART_WAS in 0|1) ;; *) die "cannot read the read-only flag of $RW_PART" ;; esac
	RW_DISK_WAS=0
	if [ -n "$RW_DISK" ]; then
		RW_DISK_WAS=$(ro_get "$RW_DISK")
		case $RW_DISK_WAS in 0|1) ;; *) die "cannot read the read-only flag of $RW_DISK" ;; esac
	fi
	# Armed before anything changes: from here on every exit restores.
	RW_ARMED=1
	if [ "$RW_DISK_WAS" = 1 ]; then
		ro_set "$RW_DISK" 0 || die "cannot clear the read-only flag of $RW_DISK"
	fi
	if [ "$RW_PART_WAS" = 1 ]; then
		ro_set "$RW_PART" 0 || die "cannot clear the read-only flag of $RW_PART"
	fi
	[ "$(ro_get "$RW_PART")" = 0 ] || die "$RW_PART is still read-only"
	[ -z "$RW_DISK" ] || [ "$(ro_get "$RW_DISK")" = 0 ] || die "$RW_DISK is still read-only"
}

# Put back what open_rw found, partition first.  Idempotent; a failure is
# remembered so that the exit status cannot report success.
close_rw() {
	[ "$RW_ARMED" = 1 ] || return 0
	RW_ARMED=0
	cr_rc=0
	if [ "$RW_PART_WAS" = 1 ]; then
		if ! ro_set "$RW_PART" 1 || [ "$(ro_get "$RW_PART")" != 1 ]; then
			printf '%s: CRITICAL: could not restore the read-only flag of %s\n' "$PROG" "$RW_PART" >&2
			log "CRITICAL read-only flag of $RW_PART not restored"
			cr_rc=1
		fi
	fi
	if [ -n "$RW_DISK" ] && [ "$RW_DISK_WAS" = 1 ]; then
		if ! ro_set "$RW_DISK" 1 || [ "$(ro_get "$RW_DISK")" != 1 ]; then
			printf '%s: CRITICAL: could not restore the read-only flag of %s\n' "$PROG" "$RW_DISK" >&2
			log "CRITICAL read-only flag of $RW_DISK not restored"
			cr_rc=1
		fi
	fi
	[ "$cr_rc" = 0 ] || RW_FAILED=1
	return $cr_rc
}

cleanup() {
	if [ "$rb_saved" = 1 ] && [ "$write_started" = 0 ]; then
		rm -f "$rb_src"
	fi
	close_rw || :
	if [ "$MOUNTED_HERE" = 1 ]; then
		MOUNTED_HERE=0
		LOG_FILE=${LIUQIN_SWITCH_LOG:-}
		if is_android; then LOG_FILE=${LIUQIN_SWITCH_LOG:-/data/adb/liuqin-switch.log}; fi
		umount "$MOUNTPOINT" 2>/dev/null || umount -l "$MOUNTPOINT" 2>/dev/null || :
	fi
	if [ "$LOCKED" = 1 ]; then
		LOCKED=0
		rmdir "$LOCK_DIR" 2>/dev/null || :
	fi
}

on_exit() {
	oe_rc=$?
	trap - EXIT
	trap '' HUP INT TERM
	cleanup
	[ "$RW_FAILED" = 0 ] || [ "$oe_rc" != 0 ] || oe_rc=1
	exit "$oe_rc"
}

# The critical sections: writing boot_a and replacing a store set.  An
# ignored signal stays ignored in the dd children too, which a handler would
# not achieve.  die() still exits and still restores the read-only flags.
critical_begin() { trap '' HUP INT TERM; }
critical_end() { trap 'exit 130' HUP INT TERM; }

# ---------------------------------------------------------------------------
# Images

sha_of_file() { sha256sum "$1" | cut -d' ' -f1; }

# Stream <bytes> zero bytes to stdout.
zeros() {
	z_left=$1
	[ "$z_left" -gt 0 ] || return 0
	[ $((z_left / 1048576)) -eq 0 ] ||
		dd if=/dev/zero bs=1048576 count=$((z_left / 1048576)) 2>/dev/null
	z_left=$((z_left % 1048576))
	[ $((z_left / 4096)) -eq 0 ] ||
		dd if=/dev/zero bs=4096 count=$((z_left / 4096)) 2>/dev/null
	z_left=$((z_left % 4096))
	[ "$z_left" -eq 0 ] || dd if=/dev/zero bs="$z_left" count=1 2>/dev/null
}

# What boot_a hashes to once <image> has been written whole: the image
# followed by zeros up to the partition size.
padded_sha() { # <image>
	ps_size=$(stat -c %s "$1") || return 1
	{ cat "$1" && zeros $((BOOT_BYTES - ps_size)); } | sha256sum | cut -d' ' -f1
}

sha_of_part() { # <device> <bytes>
	if [ $(($2 % 1048576)) -eq 0 ]; then
		dd if="$1" bs=1048576 count=$(($2 / 1048576)) 2>/dev/null
	elif [ $(($2 % 4096)) -eq 0 ]; then
		dd if="$1" bs=4096 count=$(($2 / 4096)) 2>/dev/null
	else
		dd if="$1" bs=512 count=$(($2 / 512)) 2>/dev/null
	fi | sha256sum | cut -d' ' -f1
}

# Little-endian u32 at a byte offset, in decimal.
u32_at() { # <file> <offset>
	# shellcheck disable=SC2046
	set -- $(dd if="$1" bs=1 skip="$2" count=4 2>/dev/null | od -An -tu1)
	[ "$#" = 4 ] || return 1
	printf '%s\n' "$(($1 + $2 * 256 + $3 * 65536 + $4 * 16777216))"
}

classify() { # <image or device>
	cl_magic=$(dd if="$1" bs=8 count=1 2>/dev/null | tr -d '\000')
	[ "$cl_magic" = 'ANDROID!' ] || { echo unknown; return 0; }
	cl_version=$(u32_at "$1" 40) || { echo unknown; return 0; }
	cl_kernel=$(u32_at "$1" 8) || { echo unknown; return 0; }
	[ "$cl_kernel" -gt 0 ] || { echo unknown; return 0; }
	case $cl_version in
	2)
		cl_page=$(u32_at "$1" 36) || cl_page=
		cl_header=$(u32_at "$1" 1644) || cl_header=
		cl_dtb=$(u32_at "$1" 1648) || cl_dtb=0
		if [ "$cl_page" = 4096 ] && [ "$cl_header" = 1660 ] && [ "$cl_dtb" -gt 0 ]; then
			echo ubuntu
			return 0
		fi
		;;
	3|4)
		cl_header=$(u32_at "$1" 20) || cl_header=
		if { [ "$cl_version" = 3 ] && [ "$cl_header" = 1580 ]; } ||
			{ [ "$cl_version" = 4 ] && [ "$cl_header" = 1584 ]; }; then
			echo android
			return 0
		fi
		;;
	esac
	echo unknown
}

sums_lookup() { # <set dir>
	sed -n 's/^\([0-9a-f]\{64\}\)  *\*\{0,1\}boot\.img$/\1/p' "$1/SHA256SUMS" 2>/dev/null | head -n 1
}

# A set is usable only if boot.img is present, matches its SHA256SUMS, fits
# boot_a and identifies as the kind of system the set is named after.
check_set() { # <set> [quiet]
	cs_dir=$STORE/$1
	cs_quiet=${2:-}
	cs_why=
	if [ ! -d "$cs_dir" ]; then
		cs_why="no $1 set in the store"
	elif [ ! -f "$cs_dir/SHA256SUMS" ]; then
		cs_why="store/$1 has no SHA256SUMS"
	elif [ ! -f "$cs_dir/boot.img" ]; then
		cs_why="store/$1 has no boot.img"
	else
		cs_want=$(sums_lookup "$cs_dir")
		cs_size=$(stat -c %s "$cs_dir/boot.img")
		if [ -z "$cs_want" ]; then
			cs_why="store/$1/SHA256SUMS has no entry for boot.img"
		elif [ "$(sha_of_file "$cs_dir/boot.img")" != "$cs_want" ]; then
			cs_why="store/$1/boot.img does not match its SHA256SUMS"
		elif [ "$cs_size" -gt "$BOOT_BYTES" ]; then
			cs_why="store/$1/boot.img is $cs_size bytes, larger than $BOOT_LABEL ($BOOT_BYTES)"
		elif [ "$(classify "$cs_dir/boot.img")" != "$1" ]; then
			cs_why="store/$1/boot.img does not identify as a $1 boot image"
		fi
	fi
	[ -n "$cs_why" ] || return 0
	[ -n "$cs_quiet" ] || warn "$cs_why"
	return 1
}

compute_live() {
	[ -z "$LIVE_FULL" ] || return 0
	LIVE_FULL=$(sha_of_part "$BOOT_DEV" "$BOOT_BYTES")
	LIVE_CLASS=$(classify "$BOOT_DEV")
	[ -n "$LIVE_FULL" ] || die "cannot read $BOOT_DEV"
}

# Does boot_a hold exactly this set, zero fill included?
live_is_set() { # <set>
	check_set "$1" quiet || return 1
	[ "$(padded_sha "$STORE/$1/boot.img")" = "$LIVE_FULL" ]
}

# ---------------------------------------------------------------------------
# Writing

write_image() { # <image>: whole boot_a; non-zero on a failed write
	wi_size=$(stat -c %s "$1") || return 1
	wi_pad=$((BOOT_BYTES - wi_size))
	[ "$wi_pad" -ge 0 ] || return 1
	if [ -n "$DEV_DIR" ]; then
		# The kernel refuses a write while either flag is set.
		[ "$(ro_get "$BOOT_DEV")" = 0 ] || return 1
		[ ! -e "$DEV_DIR/sde" ] || [ "$(ro_get "$DEV_DIR/sde")" = 0 ] || return 1
		# Fault injection, one shot each: a write that fails partway, and
		# a terminate signal in the middle of one (which must be ignored).
		if [ -e "$DEV_DIR/.fault-write" ]; then
			rm -f "$DEV_DIR/.fault-write"
			dd if=/dev/urandom of="$BOOT_DEV" bs=4096 count=1 conv=notrunc 2>/dev/null
			return 1
		fi
		if [ -e "$DEV_DIR/.fault-signal" ]; then
			rm -f "$DEV_DIR/.fault-signal"
			dd if=/dev/urandom of="$BOOT_DEV" bs=4096 count=1 conv=notrunc 2>/dev/null
			kill -TERM $$
		fi
	fi
	{ cat "$1" && zeros "$wi_pad"; } |
		run_logged dd of="$BOOT_DEV" bs=1048576 conv=notrunc,fsync || return 1
	sync
	if [ -n "$DEV_DIR" ]; then
		# A write the medium did not keep: the read-back has to catch it.
		if [ -e "$DEV_DIR/.fault-corrupt" ]; then
			rm -f "$DEV_DIR/.fault-corrupt"
			printf 'X' | dd of="$BOOT_DEV" bs=1 seek=4100 conv=notrunc 2>/dev/null
		fi
	else
		# Drop the page cache so the read-back comes from the device.
		run_logged blockdev --flushbufs "$BOOT_DEV" || return 1
	fi
	return 0
}

# Write one set into boot_a and prove it by reading it back.  A mismatch puts
# the other set back and stops without rebooting.
install_set() { # <set> <way-back set>
	is_src=$STORE/$1/boot.img
	is_want=$(padded_sha "$is_src")
	is_size=$(stat -c %s "$is_src")
	if [ "$DRY_RUN" = 1 ]; then
		say "dry-run: would write store/$1/boot.img ($is_size bytes, zero-filled to $BOOT_BYTES) to $BOOT_DEV"
		return 0
	fi
	# The Android store is read-only: its verified archived image must be
	# exactly the live preimage. Linux can save an older Ubuntu image too.
	rb_saved=0
	if [ "$STORE_RO" = 1 ]; then
		check_set "$2" || die 'no verified rollback image; nothing was written'
		rb_src=$STORE/$2/boot.img
		rb_want=$(padded_sha "$rb_src")
		[ "$rb_want" = "$LIVE_FULL" ] || die 'rollback image differs from the live partition; nothing was written'
	else
		[ ! -e "$STORE/.switch-rollback.img" ] || die 'a previous rollback image remains; recover it before switching'
		rb_src=$STORE/.switch-rollback.img
		rb_want=$LIVE_FULL
		(umask 077; : > "$rb_src") || die "cannot create rollback image; nothing was written"
		run_logged dd if="$BOOT_DEV" of="$rb_src" bs=1048576 conv=fsync ||
			{ rm -f "$rb_src"; die 'cannot save rollback image; nothing was written'; }
		if [ "$(stat -c %s "$rb_src")" != "$BOOT_BYTES" ] || [ "$(sha_of_file "$rb_src")" != "$rb_want" ]; then
			rm -f "$rb_src"
			die 'rollback image did not verify; nothing was written'
		fi
		rb_saved=1
	fi
	say "writing $BOOT_LABEL <- store/$1/boot.img ($is_size bytes, zero-filled to $BOOT_BYTES)"
	critical_begin
	is_wrote=1
	open_rw
	write_started=1
	write_image "$is_src" || is_wrote=0
	is_got=$(sha_of_part "$BOOT_DEV" "$BOOT_BYTES")
	if [ "$is_wrote" = 1 ] && [ "$is_got" = "$is_want" ]; then
		if ! close_rw; then
			die 'image written, but read-only protection could not be restored; not rebooting'
		fi
		[ "$rb_saved" = 0 ] || rm -f "$rb_src"
		say "verified $BOOT_LABEL = $is_got"
		LIVE_FULL=$is_got
		LIVE_CLASS=$1
		critical_end
		return 0
	fi
	warn "write or readback failed on $BOOT_LABEL (got $is_got, expected $is_want)"
	if rollback; then
		die "result=rolled-back: $BOOT_LABEL could not be written with the $1 image; original restored; the tablet was NOT rebooted"
	fi
	die "result=rollback-failed: do not reboot; recover $BOOT_LABEL from $rb_src with Fastboot. The tablet was NOT rebooted"
}

rollback() {
	warn "restoring the original image in $BOOT_LABEL"
	rb_wrote=1
	# The partition remains writable throughout failure recovery.
	[ "$(padded_sha "$rb_src")" = "$rb_want" ] || rb_wrote=0
	if [ "$rb_wrote" = 1 ]; then
		write_image "$rb_src" || rb_wrote=0
	fi
	close_rw || rb_wrote=0
	if [ "$rb_wrote" = 1 ] && [ "$(sha_of_part "$BOOT_DEV" "$BOOT_BYTES")" = "$rb_want" ]; then
		[ "$rb_saved" = 0 ] || rm -f "$rb_src"
		warn "result=rolled-back: $BOOT_LABEL holds the original image again (verified); not rebooting"
		return 0
	fi
	warn "result=rollback-failed: original image could not be restored; do not reboot. Recovery image: $rb_src"
	return 1
}

write_meta() { # <dir> <set> <source>
	{
		printf '{\n'
		printf '  "set": "%s",\n' "$2"
		printf '  "source": "%s",\n' "$3"
		printf '  "created": "%s"\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo unknown)"
		printf '}\n'
	} >"$1/meta.json"
}

# Replace store/<set> with a complete new directory, never a half-written one.
commit_set() { # <staging dir> <set>
	critical_begin
	sync
	rm -rf "$STORE/.$2.old"
	if [ -d "$STORE/$2" ]; then
		mv "$STORE/$2" "$STORE/.$2.old" || die "cannot move store/$2 aside"
	fi
	mv "$1" "$STORE/$2" || die "cannot move $1 into place"
	rm -rf "$STORE/.$2.old"
	sync
	critical_end
}

require_writable_store() {
	[ "$STORE_RO" = 0 ] ||
		die "the store is read-only here ($STORE); run this from Ubuntu"
	mkdir -p "$STORE" || die "cannot create $STORE"
}

# Archive the live boot_a as the Android set.  The caller has established
# that it identifies as Android.
stash_live() {
	if [ "$DRY_RUN" = 1 ]; then
		say "dry-run: would archive $BOOT_DEV into store/android"
		return 0
	fi
	require_writable_store
	sl_tmp=$STORE/.android.new
	rm -rf "$sl_tmp"
	mkdir -p "$sl_tmp" || die "cannot create $sl_tmp"
	dd if="$BOOT_DEV" of="$sl_tmp/boot.img" bs=1048576 count=$((BOOT_BYTES / 1048576)) 2>/dev/null ||
		die "reading $BOOT_DEV failed"
	sl_sha=$(sha_of_file "$sl_tmp/boot.img")
	[ "$sl_sha" = "$LIVE_FULL" ] || die "$BOOT_LABEL changed while it was being archived"
	[ "$(classify "$sl_tmp/boot.img")" = android ] || die 'the archived image does not identify as Android'
	printf '%s  boot.img\n' "$sl_sha" >"$sl_tmp/SHA256SUMS"
	write_meta "$sl_tmp" android "live $BOOT_LABEL"
	commit_set "$sl_tmp" android
	say "archived the live $BOOT_LABEL into store/android ($sl_sha)"
}

write_state() { # <set now in boot_a>
	[ "$DRY_RUN" = 0 ] && [ "$STORE_RO" = 0 ] || return 0
	{
		printf '{\n'
		printf '  "installed": "%s",\n' "$1"
		printf '  "partition": "%s",\n' "$BOOT_LABEL"
		printf '  "running_slot": "%s",\n' "${RUNNING_SLOT:-unknown}"
		printf '  "updated": "%s",\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || echo unknown)"
		printf '  "boot_sha256": "%s"\n' "$(sums_lookup "$STORE/$1")"
		printf '}\n'
	} >"$STORE/state.json.new" && mv "$STORE/state.json.new" "$STORE/state.json" ||
		die "image installed, but cannot record final state; not rebooting"
	sync
}

do_reboot() {
	if [ "$NO_REBOOT" = 1 ]; then
		say 'not rebooting (--no-reboot); the new system starts at the next boot'
		return 0
	fi
	say 'rebooting'
	if [ -n "$DEV_DIR" ]; then
		: >"$DEV_DIR/.rebooted"
		return 0
	fi
	sync
	if is_android; then
		run_logged svc power reboot || die 'Image installed, but reboot failed; save your work and reboot manually.'
		return 0
	fi
	run_logged systemctl reboot || die 'Image installed, but reboot failed; save your work and reboot manually.'
}

# ---------------------------------------------------------------------------
# Subcommands

require_slot_a() {
	case $RUNNING_SLOT in
	a) ;;
	b)
		die "this boot came from slot B: the bootloader fell back to the copy in boot_b because boot_a did not load.
Writing $BOOT_LABEL cannot change what boots next.  From a host in fastboot mode:
  fastboot flash boot_a <image> && fastboot --set-active=a"
		;;
	*) die 'cannot determine the running slot; nothing was written' ;;
	esac
}

describe_live() {
	if live_is_set ubuntu; then
		echo 'the Ubuntu image from the store'
	elif live_is_set android; then
		echo 'the Android image from the store'
	else
		case $LIVE_CLASS in
		ubuntu) echo 'an Ubuntu image that is not the one in the store' ;;
		android) echo 'an Android image that is not the one in the store' ;;
		*) echo 'an image that identifies as neither system' ;;
		esac
	fi
}

cmd_status() {
	compute_live
	say "running slot:     ${RUNNING_SLOT:-unknown}"
	say "$BOOT_LABEL:           $BOOT_DEV ($BOOT_BYTES bytes)"
	say "$BOOT_LABEL holds:     $(describe_live) [$LIVE_CLASS]"
	if [ "$STORE_RO" = 1 ]; then
		say "store:            $STORE (read-only)"
	else
		say "store:            $STORE"
	fi
	for st_set in ubuntu android; do
		if check_set "$st_set" quiet; then
			say "$(printf 'store/%-8s' "$st_set")  ok  $(sums_lookup "$STORE/$st_set")"
		elif [ -d "$STORE/$st_set" ]; then
			say "$(printf 'store/%-8s' "$st_set")  PRESENT BUT UNUSABLE"
		else
			say "$(printf 'store/%-8s' "$st_set")  absent"
		fi
	done
	[ ! -f "$STORE/state.json" ] || cat "$STORE/state.json"
	return 0
}

cmd_verify() {
	vf_rc=0
	for vf_set in ubuntu android; do
		if check_set "$vf_set"; then
			say "store/$vf_set: boot.img matches SHA256SUMS and identifies as $vf_set"
		else
			say "store/$vf_set: UNUSABLE"
			vf_rc=1
		fi
	done
	compute_live
	vf_live=$(describe_live)
	say "$BOOT_LABEL holds: $vf_live"
	case $vf_live in *'from the store') ;; *) vf_rc=1 ;; esac
	return $vf_rc
}

cmd_stash() {
	compute_live
	[ "$LIVE_CLASS" = android ] ||
		die "$BOOT_LABEL does not hold an Android boot image ($LIVE_CLASS); refusing to archive it as Android"
	if live_is_set android; then
		say "store/android already holds the live $BOOT_LABEL; nothing to archive"
		return 0
	fi
	stash_live
}

cmd_import_android() { # <image>
	ia_src=$1
	[ -f "$ia_src" ] || die "no such file: $ia_src"
	[ "$(classify "$ia_src")" = android ] ||
		die "$ia_src does not identify as an Android boot image (header v3/v4)"
	ia_size=$(stat -c %s "$ia_src")
	[ "$ia_size" -le "$BOOT_BYTES" ] ||
		die "$ia_src is $ia_size bytes, larger than $BOOT_LABEL ($BOOT_BYTES)"
	if [ "$DRY_RUN" = 1 ]; then
		say "dry-run: would import $ia_src into store/android"
		return 0
	fi
	require_writable_store
	ia_tmp=$STORE/.android.new
	rm -rf "$ia_tmp"
	mkdir -p "$ia_tmp" || die "cannot create $ia_tmp"
	cp "$ia_src" "$ia_tmp/boot.img" || die "cannot copy $ia_src"
	ia_sha=$(sha_of_file "$ia_tmp/boot.img")
	[ "$ia_sha" = "$(sha_of_file "$ia_src")" ] || die "$ia_src changed while it was being copied"
	printf '%s  boot.img\n' "$ia_sha" >"$ia_tmp/SHA256SUMS"
	write_meta "$ia_tmp" android "import"
	commit_set "$ia_tmp" android
	say "imported $ia_src into store/android ($ia_sha)"
}

cmd_to_ubuntu() {
	require_switch_battery
	check_set ubuntu || die "no usable Ubuntu image in store/ubuntu; nothing was written"
	require_slot_a
	compute_live
	if live_is_set ubuntu; then
		say "$BOOT_LABEL already holds the Ubuntu image; nothing to write"
		write_state ubuntu
		do_reboot
		return $?
	fi
	case $LIVE_CLASS in
	ubuntu)
		# Another Ubuntu build, a newer store image say.  Replacing it is
		# fine; archiving it as Android would destroy the way back.
		say "$BOOT_LABEL holds another Ubuntu build; replacing it, store/android unchanged"
		tu_back=android
		;;
	android)
		# The way back to Android is the archive, so it has to hold exactly
		# what is in boot_a before boot_a is overwritten.
		if live_is_set android; then
			say "store/android already holds the live Android image"
		elif [ "$STORE_RO" = 1 ]; then
			die "$BOOT_LABEL holds an Android boot image that is not the one in store/android,
and the store is read-only here, so it cannot be archived.  Overwriting it would
leave no way back.  Nothing was written.  See the dual-boot documentation:
copy boot_a off the tablet and import it from Ubuntu with
  liuqin-switch import-android <image>"
		else
			stash_live
		fi
		tu_back=android
		;;
	*)
		die "$BOOT_LABEL holds an image that identifies as neither system; refusing to overwrite it"
		;;
	esac
	install_set ubuntu "$tu_back"
	write_state ubuntu
	do_reboot
}

cmd_to_android() {
	require_switch_battery
	check_set android || die "no usable Android image in store/android; nothing was written"
	check_set ubuntu ||
		die 'store/ubuntu is unusable, so there would be no way back to Ubuntu; nothing was written'
	require_slot_a
	compute_live
	if live_is_set android; then
		say "$BOOT_LABEL already holds the Android image; nothing to write"
		write_state android
		do_reboot
		return $?
	fi
	case $LIVE_CLASS in
	ubuntu) ;;
	android)
		die "$BOOT_LABEL holds an Android image that is not the one in store/android; refusing to overwrite it"
		;;
	*)
		die "$BOOT_LABEL holds an image that identifies as neither system; refusing to overwrite it"
		;;
	esac
	install_set android ubuntu
	write_state android
	do_reboot
}

usage() {
	cat <<'EOF'
liuqin-switch -- rotate the Android and Ubuntu boot images through boot_a.

  liuqin-switch <subcommand> [options]

Subcommands:
  status                what boot_a holds and what the store holds; no writes
  verify                re-hash the store and boot_a; non-zero if anything is off
  stash-android         archive the live boot_a into store/android (Android only)
  import-android IMG    put an Android boot image file into store/android
  to-ubuntu             archive Android if needed, write the Ubuntu image, reboot
  to-android            write the archived Android image, reboot

Options:
  --no-reboot           do everything but the reboot
  --dry-run             report what would be written; writes nothing at all
  --store DIR           use this store instead of /var/lib/liuqin/switch
  --read-only-store     never write the store (the Android side always is)
  --dev-dir DIR         resolve partitions as plain files in DIR (tests only)

Runs as root: sudo or pkexec on Ubuntu, a KernelSU root shell on Android.
EOF
	exit "${1:-0}"
}

# ---------------------------------------------------------------------------

command=
import_source=
while [ $# -gt 0 ]; do
	case $1 in
	status|verify|stash-android|to-ubuntu|to-android)
		[ -z "$command" ] || usage 1
		command=$1
		;;
	import-android)
		[ -z "$command" ] || usage 1
		command=$1
		shift
		[ $# -gt 0 ] || usage 1
		import_source=$1
		;;
	--no-reboot) NO_REBOOT=1 ;;
	--dry-run) DRY_RUN=1; NO_REBOOT=1 ;;
	--store) shift; STORE=${1:-} ;;
	--store=*) STORE=${1#--store=} ;;
	--read-only-store) STORE_RO=1 ;;
	--dev-dir) shift; DEV_DIR=${1:-} ;;
	--dev-dir=*) DEV_DIR=${1#--dev-dir=} ;;
	-h|--help) usage 0 ;;
	*) warn "unknown argument: $1"; usage 1 ;;
	esac
	shift
done
[ -n "$command" ] || usage 1
[ "$(id -u)" = 0 ] ||
	die 'must run as root (Ubuntu: sudo or pkexec; Android: a KernelSU root shell)'
if [ -n "$DEV_DIR" ]; then
	[ -d "$DEV_DIR" ] || die "no such directory: $DEV_DIR"
	# A test run must never reach the real store.
	[ -n "$STORE" ] || die '--dev-dir needs --store'
fi

trap on_exit EXIT
trap 'exit 130' HUP INT TERM

# One switch at a time: a second tap on the button must not interleave.
if [ -n "$DEV_DIR" ]; then
	LOCK_DIR=$DEV_DIR/.lock
elif [ -d /run ] && ! is_android; then
	LOCK_DIR=/run/liuqin-switch.lock
else
	LOCK_DIR=/dev/liuqin-switch.lock
fi
mkdir "$LOCK_DIR" 2>/dev/null || die "another liuqin-switch is running ($LOCK_DIR)"
LOCKED=1

BOOT_DEV=$(resolve_part "$BOOT_LABEL") || die "no $BOOT_LABEL partition on this device"
BOOT_BYTES=$(part_bytes "$BOOT_DEV") || BOOT_BYTES=
case $BOOT_BYTES in ''|*[!0-9]*|0) die "cannot size $BOOT_DEV" ;; esac
if [ -z "$DEV_DIR" ] && [ "$BOOT_BYTES" != "$BOOT_BYTES_PINNED" ]; then
	die "$BOOT_DEV is $BOOT_BYTES bytes, not the 192 MiB boot_a of this tablet; refusing"
fi

if [ -n "$STORE" ]; then
	:
elif is_android; then
	# Android's 5.10 kernel cannot mount this ext4 read-write (orphan_file),
	# and must not replay its journal either: ro,noload writes nothing.
	STORE_RO=1
	ms_dev=$(resolve_part "$ROOT_LABEL") || die "no $ROOT_LABEL partition on this device"
	mkdir -p "$MOUNTPOINT" || die "cannot create $MOUNTPOINT"
	if ! grep -q " $MOUNTPOINT " /proc/mounts 2>/dev/null; then
		mount -t ext4 -o ro,noload "$ms_dev" "$MOUNTPOINT" ||
			die "cannot mount $ms_dev ($ROOT_LABEL) read-only on $MOUNTPOINT"
		MOUNTED_HERE=1
	fi
	STORE=$MOUNTPOINT/$ROOT_SUBDIR$STORE_DEFAULT
	[ -d "$STORE" ] || die "$ROOT_LABEL carries no switch store ($STORE_DEFAULT)"
else
	STORE=$STORE_DEFAULT
fi
if [ "$DRY_RUN" = 1 ]; then
	# A dry run writes nothing, not even the log.
	LOG_FILE=
else
	if [ "$STORE_RO" = 0 ]; then
		# The store is writable if it can be created and written; otherwise
		# it is treated as read-only rather than failing halfway through.
		if ! mkdir -p "$STORE" 2>/dev/null || ! : >"$STORE/.write-test" 2>/dev/null; then
			STORE_RO=1
		fi
		rm -f "$STORE/.write-test" 2>/dev/null
	fi
	if [ "$STORE_RO" = 0 ]; then
		LOG_FILE=$STORE/switch.log
	else
		LOG_FILE=${LIUQIN_SWITCH_LOG:-}
		if is_android; then LOG_FILE=${LIUQIN_SWITCH_LOG:-/data/adb/liuqin-switch.log}; fi
	fi
fi

detect_running_slot
log "=== $command running_slot=${RUNNING_SLOT:-unknown} dry_run=$DRY_RUN store=$STORE store_ro=$STORE_RO"

case $command in
status) cmd_status ;;
verify) cmd_verify ;;
stash-android) cmd_stash ;;
import-android) cmd_import_android "$import_source" ;;
to-ubuntu) cmd_to_ubuntu ;;
to-android) cmd_to_android ;;
esac
