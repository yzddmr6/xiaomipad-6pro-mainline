#!/bin/sh
# SPDX-License-Identifier: MIT
# Ordinary users and headless audio sessions keep their usual activation.
set -eu
test -e "${XDG_RUNTIME_DIR:?}/liuqin-compositor-ready" && exit 0
sessions=$(loginctl show-user "$(id -u)" --property=Sessions --value) || exit 0
for session in $sessions; do
    class=$(loginctl show-session "$session" --property=Class --value) || continue
    test "$class" != greeter || exit 1
done
exit 0
