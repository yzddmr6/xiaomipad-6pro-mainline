# Developer mode: SSH login over the USB cable.  Off by default; the
# administrator turns it on with `liuqin-devmode on`, which is
# `systemctl enable --now liuqin-devmode.service`, and the enablement state is
# the only persisted switch.  The unit is wanted by usb-gadget.target, which
# udev starts once the USB device controller exists.  While it runs it holds
# a blocking sleep inhibitor: idle suspend on external power would otherwise
# cut the SSH link of an enabled developer mode.
[Unit]
Description=Liuqin developer mode (SSH over USB)
Wants=systemd-networkd.service liuqin-devmode-ssh.socket

[Service]
Type=notify
NotifyAccess=all
# sshd -t needs the privilege separation directory, as in ssh.service.
RuntimeDirectory=sshd
RuntimeDirectoryMode=0755
RuntimeDirectoryPreserve=yes
ExecStartPre=/usr/sbin/liuqin-devmode check
# systemd-inhibit does not pass NOTIFY_SOCKET on to its child, so the socket
# path is handed to the gadget script as an argument (as on the 8 Pro).
ExecStart=/usr/bin/systemd-inhibit --what=sleep --mode=block --who=liuqin-devmode "--why=USB developer connection is enabled" /usr/libexec/liuqin/devmode-gadget serve ${NOTIFY_SOCKET}
ExecStop=/usr/libexec/liuqin/devmode-gadget stop

[Install]
WantedBy=usb-gadget.target
