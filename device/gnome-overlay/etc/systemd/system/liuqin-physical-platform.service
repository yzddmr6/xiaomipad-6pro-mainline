[Unit]
Description=Verify physical tablet identity established by initramfs
DefaultDependencies=no
After=local-fs.target
Before=sysinit.target

[Service]
Type=oneshot
TimeoutStartSec=15
ExecStart=/usr/local/libexec/liuqin-physical-platform --verify
RemainAfterExit=yes

[Install]
WantedBy=sysinit.target
