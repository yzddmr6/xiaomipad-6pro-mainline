[org/gnome/desktop/interface]
# 1800x2880 on a 11" panel. At 1x everything is unreadable.
scaling-factor=uint32 2

[org/gnome/desktop/a11y/applications]
# There is no keyboard attached and no guarantee one ever will be.
screen-keyboard-enabled=true

[org/gnome/desktop/session]
# Five minutes. This was 0 -- never blank -- while the display was still being
# brought up, because a panel that blanks on its own is indistinguishable from
# one that has failed, and this project had already spent a session on that
# confusion. The display is settled now, and "never blank" is no longer free:
# on battery it is the single most expensive default the desktop has, and the
# reason it was set no longer exists.
idle-delay=uint32 300

[org/gnome/settings-daemon/plugins/power]
# GNOME cannot assign different actions to short and long KEY_POWER presses.
# liuqin-power-keyd owns that duration policy, while deliberately leaving the
# evdev stream visible to Mutter so a press still wakes the panel. Prevent GSD
# from opening or accidentally confirming its own shutdown dialog in parallel.
power-button-action='nothing'

# On battery, suspend after 15 idle minutes, which is the GNOME default and
# what the login screen already does. Staying awake with only the screen off
# draws about 2.3-2.6 W here and empties the battery in one night.
# On external power the board stays awake: s2idle does not stay asleep here
# while the charger firmware is active, so suspending would save nothing.
sleep-inactive-ac-type='nothing'
sleep-inactive-battery-type='suspend'
sleep-inactive-battery-timeout=900

[org/gnome/desktop/screensaver]
# A short power-key press explicitly locks even on the current development
# account. With its empty password this is a screen shield, not an authentication
# boundary; setting a real password remains a separate product gate.
lock-enabled=true
