#!/bin/sh
# SPDX-License-Identifier: MIT
# Read-only RAM status over USB NCM. No login, CGI or persistent-root mount.
set -eu
bb=${LIUQIN_CHARGER_BUSYBOX:-/bin/busybox}
gadget=/sys/kernel/config/usb_gadget/liuqin-charge
root=/run/liuqin-charge
mkdir -p "$root" "$gadget/strings/0x409" "$gadget/configs/c.1/strings/0x409"
if [ -z "$(cat "$gadget/UDC" 2>/dev/null || true)" ]; then
    echo 0x1d6b >"$gadget/idVendor"
    echo 0x0104 >"$gadget/idProduct"
    echo 0x0200 >"$gadget/bcdUSB"
    serial=
    for word in $(cat /proc/cmdline); do
        case $word in androidboot.serialno=*) serial=${word#*=} ;; esac
    done
    case $serial in ''|*[!a-zA-Z0-9_-]*) serial=liuqin-charging ;; esac
    printf '%s\n' "$serial" >"$gadget/strings/0x409/serialnumber"
    echo 'Xiaomi Pad 6 Pro mainline' >"$gadget/strings/0x409/manufacturer"
    echo 'liuqin charging status' >"$gadget/strings/0x409/product"
    echo 'Read-only charging status' >"$gadget/configs/c.1/strings/0x409/configuration"
    echo 500 >"$gadget/configs/c.1/MaxPower"
    mkdir -p "$gadget/functions/ncm.usb0"
    echo 02:00:00:00:66:02 >"$gadget/functions/ncm.usb0/dev_addr"
    echo 02:00:00:00:66:01 >"$gadget/functions/ncm.usb0/host_addr"
    [ -L "$gadget/configs/c.1/ncm.usb0" ] ||
        ln -s "$gadget/functions/ncm.usb0" "$gadget/configs/c.1/ncm.usb0"
    for role in /sys/class/usb_role/*/role; do
        [ ! -w "$role" ] || echo device >"$role"
    done
    set -- /sys/class/udc/*
    [ -e "$1" ] || exit 1
    echo "${1##*/}" >"$gadget/UDC"
fi
iface=$(cat "$gadget/functions/ncm.usb0/ifname")
"$bb" ip address replace 192.168.66.2/24 dev "$iface"
"$bb" ip link set "$iface" up
# Bind only the directly connected USB subnet, after its address exists.
# The document root contains generated telemetry, never a device node or a
# persistent-file symlink. No CGI program is installed.
if [ ! -s "$root/httpd.pid" ] || ! kill -0 "$(cat "$root/httpd.pid")" 2>/dev/null; then
    "$bb" httpd -f -p 192.168.66.2:8080 -h "$root" >/run/liuqin-charge-httpd.log 2>&1 &
    echo "$!" >"$root/httpd.pid"
fi
