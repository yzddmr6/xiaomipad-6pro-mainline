From: yzddmr6 <46088090+yzddmr6@users.noreply.github.com>
Subject: [PATCH] hexagonrpcd: validate listener continuations and test large inputs

The preceding patch imports upstream f0dfd509. Add its missing
required-length check, following Qualcomm fastrpc v1.0.7 listener_android.c;
clean up partial decodes and listener-owned buffers on transport failure.
Match empty error-reply sizing to the existing encoder (also corrected in
upstream PR #27 commit 40e50412812adce9dddc2be9a4510ebce05eef89).

The original Piano tests drive production apps_std/HexagonFS write handlers.
The Liuqin adaptation below retains the production marshaller/listener and
checks the same continuation context, offset, lengths and fd=-1 ABI using an
explicit protocol receiver. It verifies binary input and scratch-file bytes
at 4 KiB and 64 KiB, 256/257-byte encoded boundaries, transport/length/cap/
truncation errors, and an AEE_EUNSUPPORTED reply.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
Liuqin adaptation: retain the existing registry tests/exported dispatcher.
The pinned liuqin apps_std is read-only, so the large-input test substitutes
an explicit byte-checking protocol receiver, not Piano's writable registry.
Marshaller, listener, continuation ABI and all nine scenarios remain real.
Only the receiver is a fixture; no product filesystem-write claim is made.
---
diff --git a/hexagonrpcd/iobuffer.c b/hexagonrpcd/iobuffer.c
index 7bc770a..04c9336 100644
--- a/hexagonrpcd/iobuffer.c
+++ b/hexagonrpcd/iobuffer.c
@@ -143,7 +143,7 @@ struct fastrpc_decoder_context *inbuf_decode_start(uint32_t sc)
 	ctx->buf_off = 0;
 	ctx->align = 0;
 
-	ctx->inbufs = malloc(sizeof(*ctx->inbufs) * ctx->n_inbufs);
+	ctx->inbufs = calloc(ctx->n_inbufs, sizeof(*ctx->inbufs));
 	if (ctx->inbufs == NULL && ctx->n_inbufs != 0)
 		goto err;
 
@@ -168,6 +168,12 @@ int inbuf_decode_is_complete(struct fastrpc_decoder_context *ctx)
 	return ctx->idx >= ctx->n_inbufs;
 }
 
+void inbuf_decode_abort(struct fastrpc_decoder_context *ctx)
+{
+	iobuf_free(ctx->n_inbufs, ctx->inbufs);
+	free(ctx);
+}
+
 int inbuf_decode(struct fastrpc_decoder_context *ctx, size_t len, const void *src)
 {
 	const char *buf = src;
@@ -199,9 +205,12 @@ size_t outbufs_calculate_size(size_t n_outbufs, const struct fastrpc_io_buffer *
 	for (i = 0; i < n_outbufs; i++) {
 		size += 4;
 
-		if (size & 0x7)
-			size += 8 - (size & 0x7);
-		size += outbufs[i].s;
+		/* Match outbufs_encode: empty error replies have only a size word. */
+		if (outbufs[i].s) {
+			if (size & 0x7)
+				size += 8 - (size & 0x7);
+			size += outbufs[i].s;
+		}
 	}
 
 	return size;
diff --git a/hexagonrpcd/iobuffer.h b/hexagonrpcd/iobuffer.h
index de4218d..9f9baf9 100644
--- a/hexagonrpcd/iobuffer.h
+++ b/hexagonrpcd/iobuffer.h
@@ -47,6 +47,7 @@ void iobuf_free(size_t n_iobufs, struct fastrpc_io_buffer *iobufs);
 
 struct fastrpc_decoder_context *inbuf_decode_start(uint32_t sc);
 struct fastrpc_io_buffer *inbuf_decode_finish(struct fastrpc_decoder_context *ctx);
+void inbuf_decode_abort(struct fastrpc_decoder_context *ctx);
 int inbuf_decode_is_complete(struct fastrpc_decoder_context *ctx);
 int inbuf_decode(struct fastrpc_decoder_context *ctx, size_t len, const void *src);
 
diff --git a/hexagonrpcd/listener.c b/hexagonrpcd/listener.c
index 8912849..94bcf34 100644
--- a/hexagonrpcd/listener.c
+++ b/hexagonrpcd/listener.c
@@ -462,6 +462,12 @@ static int fetch_large_inbufs(int fd, uint32_t rctx, uint32_t inbufs_len,
 		return -1;
 	}
 
+	/* Qualcomm's listener checks the required length against total capacity. */
+	if (got > inbufs_len) {
+		fprintf(stderr, "Large input requirement changed: %u > %u\n", got, inbufs_len);
+		free(buf);
+		return -1;
+	}
 	*out = buf;
 
 	return 0;
@@ -529,17 +535,20 @@ static int return_for_next_invoke(int fd,
 	ret = inbuf_decode(ctx, inbufs_len, src);
 	if (ret) {
 		perror("Could not decode");
-		goto err_free_large;
+		goto err_abort_decode;
 	}
 
 	if (!inbuf_decode_is_complete(ctx)) {
 		fprintf(stderr, "Expected more input buffers\n");
 		ret = -1;
-		goto err_free_large;
+		goto err_abort_decode;
 	}
 
 	*decoded = inbuf_decode_finish(ctx);
+	goto err_free_large;
 
+err_abort_decode:
+	inbuf_decode_abort(ctx);
 err_free_large:
 	free(large);
 err_free_outbufs:
@@ -664,8 +673,11 @@ int run_fastrpc_listener(int fd,
 		if (ret)
 			break;
 
-		if (returned != NULL)
+		if (returned != NULL) {
 			iobuf_free(n_outbufs, returned);
+			returned = NULL;
+		}
+		n_outbufs = REMOTE_SCALARS_OUTBUFS(sc);
 
 		ret = fastrpc_invoke_requested_procedure(n_ifaces, ifaces,
 							 handle, sc, &result,
@@ -673,11 +685,15 @@ int run_fastrpc_listener(int fd,
 		if (ret)
 			break;
 
-		if (decoded != NULL)
+		if (decoded != NULL) {
 			iobuf_free(REMOTE_SCALARS_INBUFS(sc), decoded);
-
-		n_outbufs = REMOTE_SCALARS_OUTBUFS(sc);
+			decoded = NULL;
+		}
 	}
 
+	if (decoded != NULL)
+		iobuf_free(REMOTE_SCALARS_INBUFS(sc), decoded);
+	if (returned != NULL)
+		iobuf_free(n_outbufs, returned);
 	return ret;
 }
diff --git a/tests/meson.build b/tests/meson.build
index 8a6fcb6..181c507 100644
--- a/tests/meson.build
+++ b/tests/meson.build
@@ -62,6 +62,22 @@
   args : [meson.current_build_dir()])
 test('sns-registry', test_sns_registry)
 
