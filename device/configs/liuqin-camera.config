# Front IMX596 and rear S5KJN1 capture, with libcamera software-ISP buffers.
# Keep after liuqin-trim.config: the camera clock controller is required.
CONFIG_SM_CAMCC_8450=m
CONFIG_I2C_QCOM_CCI=m
CONFIG_VIDEO_QCOM_CAMSS=m
CONFIG_VIDEO_S5KJN1=m
CONFIG_VIDEO_IMX596=m
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
