#!/bin/busybox sh

# All storage admission decisions are made through this pinned, statically
# linked BusyBox.  Do not rely on PATH here: the persistent root is mutable
# until storage_root_ok() has completed twice (RO and RW mounts).
BB=/bin/busybox
if [ "${LIUQIN_INIT_STORAGE_TEST_ONLY:-0}" = 1 ]; then
	BB=${LIUQIN_INIT_TEST_BUSYBOX:?test BusyBox path is required}
fi

if [ "${LIUQIN_INIT_STORAGE_TEST_ONLY:-0}" = 1 ]; then
	PATH=${LIUQIN_INIT_TEST_PATH:?test command path is required}
else
	PATH=/bin:/sbin:/usr/bin:/usr/sbin
fi
export PATH

log() {
	# Host tests enter the storage gate only (LIUQIN_INIT_STORAGE_TEST_ONLY)
	# and have no console or kmsg to read back, so the mutation harness can
	# redirect the log into a file.  Both gates must hold; the device path
	# below is unchanged.
	if [ "${LIUQIN_INIT_STORAGE_TEST_ONLY:-0}" = 1 ] &&
		[ -n "${LIUQIN_INIT_TEST_LOG:-}" ]; then
		echo "liuqin-initramfs: $*" >>"$LIUQIN_INIT_TEST_LOG" 2>/dev/null || true
		return 0
	fi
	echo "liuqin-initramfs: $*" >/dev/console 2>/dev/null || true
	echo "liuqin-initramfs: $*" >/dev/kmsg 2>/dev/null || true
}

# The normal development image remains fail-closed and RAM-only.  A separately
# built persistent image contains /etc/liuqin-storage-mode with the single word
# "persistent".  Even in that image we begin by making every UFS block device
# read-only.  The userdata partition is opened only after its identity
# (PARTNAME, filesystem label, marker file and root contract) has been checked
# while it is mounted read-only.  Capacity variants move userdata inside the
# GPT, so the partition is resolved by name, not by a pinned number.
storage_mode=readonly
storage_mode_file=/etc/liuqin-storage-mode
if [ -r "$storage_mode_file" ]; then
	storage_mode=invalid
	if [ -f "$storage_mode_file" ] && [ ! -L "$storage_mode_file" ] &&
		[ "$("$BB" stat -c '%a %u %g' "$storage_mode_file" 2>/dev/null || true)" = "644 0 0" ]; then
		storage_mode_hash=$("$BB" sha256sum "$storage_mode_file" 2>/dev/null | "$BB" cut -d' ' -f1)
		case $storage_mode_hash in
		e8556b2a4c237957175ab9e9f63a67b39feb54b8d33b2b27f7e3c9af0d323900)
			storage_mode=readonly ;;
		2379fbb41e49286e1db0105b7e80733626056b8a95c5f92963514e3b9b33ca7b)
			storage_mode=persistent ;;
		esac
	fi
fi
case $storage_mode in
	readonly|persistent) ;;
	*)
		log "warning: invalid storage mode; forcing readonly RAM root"
		storage_mode=readonly
		;;
esac

storage_profile=legacy
storage_profile_file=/etc/liuqin-root-profile
if [ "${LIUQIN_INIT_STORAGE_TEST_ONLY:-0}" = 1 ]; then
	storage_profile_file=${LIUQIN_STORAGE_PROFILE_FILE:-$storage_profile_file}
fi
if [ -r "$storage_profile_file" ]; then
	storage_profile=invalid
	if [ -f "$storage_profile_file" ] && [ ! -L "$storage_profile_file" ] &&
		[ "$("$BB" stat -c '%a %u %g' "$storage_profile_file" 2>/dev/null || true)" = "644 0 0" ]; then
		case $("$BB" sha256sum "$storage_profile_file" | "$BB" cut -d' ' -f1) in
		497a8b108a3eefc839c3738a5c452ee3d6a437eb1ebaf0ea43bd635a8a227978) storage_profile=gnome ;;
		c54b6fd77bc699a17876ed9b46dcf770b66d0bd01380e25cd620ec82adf9c736) storage_profile=native ;;
		esac
	fi
fi
case $storage_profile in
	legacy|gnome|native) ;;
	*)
		log "warning: invalid root profile; forcing legacy"
		storage_profile=legacy
		;;
esac

# Qualcomm A/B: which slot this boot came from.  ABL spells it
# `androidboot.slot_suffix=_a`; a hand-written or QEMU cmdline may use the bare
# `slot_suffix=_a`.  Both are accepted, they must agree, and the value must be
# `_a` or `_b`.  On success slot_suffix is set to `a` or `b`; every other shape
# -- key absent, value not a/b, two keys disagreeing -- clears it and fails, so
# the caller can refuse to touch slot metadata it does not understand.
slot_from_cmdline() {
	slot_suffix=
	slot_bad=0
	set -f
	for slot_word in $1; do
		case $slot_word in
		androidboot.slot_suffix=*) slot_value=${slot_word#androidboot.slot_suffix=} ;;
		slot_suffix=*) slot_value=${slot_word#slot_suffix=} ;;
		*) continue ;;
		esac
		case $slot_value in
		_a) slot_value=a ;;
		_b) slot_value=b ;;
		*) slot_bad=1; continue ;;
		esac
		[ -z "$slot_suffix" ] || [ "$slot_suffix" = "$slot_value" ] || slot_bad=1
		slot_suffix=$slot_value
	done
	set +f
	[ "$slot_bad" = 0 ] && [ -n "$slot_suffix" ] || { slot_suffix=; return 1; }
	return 0
}

storage_dev_root=${LIUQIN_STORAGE_DEV_ROOT:-/dev}
storage_sys_block=${LIUQIN_STORAGE_SYS_BLOCK:-/sys/class/block}
storage_mounts=${LIUQIN_STORAGE_MOUNTS:-/proc/mounts}
storage_installer_marker=${LIUQIN_STORAGE_INSTALLER_MARKER:-/etc/liuqin-installer}
storage_probe_root=${LIUQIN_STORAGE_PROBE_ROOT:-/mnt/persistent-root}
storage_newroot=${LIUQIN_STORAGE_NEWROOT:-/newroot}
storage_target_name=
storage_target=
storage_home_name=
storage_home=
storage_parent=$storage_dev_root/sda
storage_marker=etc/liuqin-persistent-root
storage_marker_sha256=0d354b25a425dcc17da2c7a8bbdaae09274cecdb1f137c70630ebe5634fa9a48
storage_root_contract=/etc/liuqin-persistent-root.contract
storage_root_subdir=
storage_init=/sbin/init
storage_gnome_contract=/etc/liuqin-gnome-root.contract
storage_native_contract=/etc/liuqin-native-root.contract
if [ "$storage_profile" = gnome ]; then
	storage_marker=etc/liuqin-gnome-root
	storage_marker_sha256=bd86a359f5b6bf05f09abf544967489e924c251ab7c07684df62b0dbda4c3fca
	storage_root_subdir=gnome-root
	storage_init=/usr/lib/systemd/systemd
fi
if [ "$storage_profile" = native ]; then
	storage_marker=etc/liuqin-native-root
	storage_marker_sha256=4fdae4f7a27af8b0d4a2bbc168c7f01c3c5c6b5e245fcc521389d662f8212c5b
	storage_root_subdir=native-root
	storage_init=/usr/lib/systemd/systemd
fi
if [ "${LIUQIN_INIT_STORAGE_TEST_ONLY:-0}" = 1 ]; then
	storage_root_contract=${LIUQIN_STORAGE_ROOT_CONTRACT:-$storage_root_contract}
	storage_gnome_contract=${LIUQIN_STORAGE_GNOME_CONTRACT:-$storage_gnome_contract}
	storage_native_contract=${LIUQIN_STORAGE_NATIVE_CONTRACT:-$storage_native_contract}
fi
storage_rcs_expected_sha256=
storage_inittab_expected_sha256=
storage_busybox_expected_sha256=
storage_probe_mounted=false
storage_root_mounted=false
storage_fallback_safe=true
storage_sd_nodes_snapshot=
storage_sd_nodes_snapshot_taken=false

storage_path_is_block() {
	[ -b "$1" ] && return 0
	# Host-side mutation tests cannot create block nodes without privilege.  The
	# bypass is reachable only through the explicit test entry point below; a
	# production boot never receives this environment variable.
	[ "${LIUQIN_INIT_STORAGE_TEST_ONLY:-0}" = 1 ] && [ -f "$1" ]
}

storage_value() {
	[ -r "$1" ] || return 1
	IFS= read -r storage_read_value <"$1" || return 1
	printf '%s\n' "$storage_read_value"
}

storage_uevent_value() {
	storage_uevent_key=$1
	storage_uevent_file=$2
	[ -r "$storage_uevent_file" ] || return 1
	while IFS='=' read -r storage_key storage_value_read; do
		[ "$storage_key" = "$storage_uevent_key" ] || continue
		printf '%s\n' "$storage_value_read"
		return 0
	done <"$storage_uevent_file"
	return 1
}

storage_source_is_mounted() {
	storage_mounted_target=$("$BB" readlink -f "$1" 2>/dev/null || true)
	[ -n "$storage_mounted_target" ] || return 1
	[ -r "$storage_mounts" ] || return 0
	while IFS=' ' read -r storage_mount_source _; do
		storage_mounted_source=$("$BB" readlink -f "$storage_mount_source" 2>/dev/null || true)
		[ "$storage_mounted_source" != "$storage_mounted_target" ] || return 0
	done <"$storage_mounts"
	return 1
}

# The writable persistent root is a whole partition on the first UFS LUN.  In
# the dual-boot split layout it is `linux_root`; a single-system install still
# hands over `userdata`.  Resolve it by PARTNAME rather than a pinned partition
# number -- liuqin capacity variants share the LUN but not the exact GPT
# offsets -- and prefer `linux_root` so a split layout never picks the Android
# /data partition.  `/dev/disk/by-partlabel/linux_root` is the same information
# by another name and only exists in installer mode, so it is used as a
# cross-check, not as the source of truth.  Anything ambiguous (missing,
# duplicated, on another LUN, or disagreeing with by-partlabel) fails closed.
storage_resolve_target() {
	storage_resolved_name=
	storage_resolved_partname=
	for storage_partname in linux_root userdata; do
		for storage_uevent in "$storage_sys_block"/sd*/uevent; do
			[ -r "$storage_uevent" ] || continue
			[ "$(storage_uevent_value PARTNAME "$storage_uevent" 2>/dev/null || true)" = "$storage_partname" ] || continue
			storage_candidate=${storage_uevent%/uevent}
			storage_candidate=${storage_candidate##*/}
			case $storage_candidate in
			sda[0-9]*) ;;
			*) return 1 ;;
			esac
			[ -z "$storage_resolved_name" ] || return 1
			storage_resolved_name=$storage_candidate
		done
		[ -z "$storage_resolved_name" ] || { storage_resolved_partname=$storage_partname; break; }
	done
	[ -n "$storage_resolved_name" ] || return 1
	storage_target_name=$storage_resolved_name
	storage_target=$storage_dev_root/$storage_target_name
	storage_partlabel_link=$storage_dev_root/disk/by-partlabel/linux_root
	if [ -e "$storage_partlabel_link" ]; then
		[ "$("$BB" readlink -f "$storage_partlabel_link" 2>/dev/null || true)" = "$storage_target" ] || return 1
	fi
	return 0
}

# In the split layout /home is its own `linux_home` partition, mounted by
# systemd from the real root's fstab (LABEL=LIUQIN_HOME, nofail).  The
# initramfs never mounts it, but the fail-closed baseline sealed every UFS node
# with BLKROSET and that kernel-level read-only flag survives switch_root:
# without clearing it systemd mounts /home read-only ("source write-protected,
# mounted read-only") and nothing can create a user home directory.  Resolution
# mirrors the root's -- PARTNAME on the first LUN, exactly one node, no alias,
# cross-checked against the filesystem label -- and anything ambiguous leaves
# the partition sealed.  Ambiguity here is not a boot failure: the fstab entry
# is `nofail` by design, so a missing, duplicated or unlabelled home partition
# must reach a desktop with /home on the root filesystem instead of no boot.
storage_resolve_home() {
	storage_home_name=
	storage_home=
	[ "$storage_resolved_partname" = linux_root ] || return 1
	storage_home_resolved_name=
	for storage_uevent in "$storage_sys_block"/sd*/uevent; do
		[ -r "$storage_uevent" ] || continue
		[ "$(storage_uevent_value PARTNAME "$storage_uevent" 2>/dev/null || true)" = linux_home ] || continue
		storage_home_candidate=${storage_uevent%/uevent}
		storage_home_candidate=${storage_home_candidate##*/}
		case $storage_home_candidate in
		sda[0-9]*) ;;
		*) return 1 ;;
		esac
		[ -z "$storage_home_resolved_name" ] || return 1
		storage_home_resolved_name=$storage_home_candidate
	done
	[ -n "$storage_home_resolved_name" ] || return 1
	storage_home_path=$storage_dev_root/$storage_home_resolved_name
	[ "$storage_home_path" != "$storage_target" ] || return 1
	[ "$storage_home_path" != "$storage_parent" ] || return 1
	storage_path_is_block "$storage_home_path" || return 1
	[ "$("$BB" readlink -f "$storage_home_path" 2>/dev/null || true)" = "$storage_home_path" ] || return 1
	storage_home_label_path=$("$BB" findfs LABEL=LIUQIN_HOME 2>/dev/null || true)
	[ -n "$storage_home_label_path" ] || return 1
	[ "$("$BB" readlink -f "$storage_home_label_path" 2>/dev/null || true)" = "$storage_home_path" ] || return 1
	! storage_source_is_mounted "$storage_home_path" || return 1
	storage_home_name=$storage_home_resolved_name
	storage_home=$storage_home_path
	return 0
}

storage_identity_ok() {
	storage_resolve_target || return 1
	storage_path_is_block "$storage_parent" || return 1
	storage_path_is_block "$storage_target" || return 1
	[ "$("$BB" readlink -f "$storage_parent" 2>/dev/null || true)" = "$storage_parent" ] || return 1
	[ "$("$BB" readlink -f "$storage_target" 2>/dev/null || true)" = "$storage_target" ] || return 1

	[ "$(storage_value "$storage_sys_block/sda/queue/logical_block_size" 2>/dev/null || true)" = 4096 ] || return 1
	storage_target_size=$(storage_value "$storage_sys_block/$storage_target_name/size" 2>/dev/null || true)
	case $storage_target_size in ''|*[!0-9]*) return 1 ;; esac
	[ "$storage_target_size" -ge 33554432 ] || return 1

	# The filesystem label is still the authority on "this is our root".
	# PARTNAME only says which partition to look at; say which of the two
	# routes named it, because a split-layout install that silently fell
	# back to userdata is a misinstall, not a working boot.
	storage_label_path=$("$BB" findfs LABEL=LIUQIN_ROOT 2>/dev/null || true)
	[ -n "$storage_label_path" ] || return 1
	[ "$("$BB" readlink -f "$storage_label_path" 2>/dev/null || true)" = "$storage_target" ] || return 1
	if [ "$storage_resolved_partname" = linux_root ]; then
		log "persistent root resolved via PARTNAME=linux_root ($storage_target), LABEL=LIUQIN_ROOT confirmed"
	else
		log "persistent root resolved via PARTNAME=userdata ($storage_target), LABEL=LIUQIN_ROOT confirmed"
	fi
	! storage_source_is_mounted "$storage_parent" || return 1
	! storage_source_is_mounted "$storage_target" || return 1
	storage_home_name=
	storage_home=
	if [ "$storage_resolved_partname" = linux_root ]; then
		if storage_resolve_home; then
			log "persistent home resolved via PARTNAME=linux_home ($storage_home), LABEL=LIUQIN_HOME confirmed"
		else
			log "persistent home not resolved via PARTNAME=linux_home/LABEL=LIUQIN_HOME; leaving it sealed read-only, /home stays on the root filesystem"
		fi
	fi
	return 0
}

storage_root_contract_ok() {
	[ -f "$storage_root_contract" ] || return 1
	[ ! -L "$storage_root_contract" ] || return 1
	[ "$("$BB" stat -c '%a %u %g %s' "$storage_root_contract" 2>/dev/null || true)" = "644 0 0 453" ] || return 1
	storage_root_contract_lines=0
	storage_rcs_expected_sha256=
	storage_inittab_expected_sha256=
	storage_busybox_expected_sha256=
	while IFS= read -r storage_root_contract_line; do
		storage_root_contract_lines=$((storage_root_contract_lines + 1))
		case $storage_root_contract_lines:$storage_root_contract_line in
		1:LIUQIN_PERSISTENT_ROOT_CONTRACT_V2) ;;
		2:rootfs_sha256=????????????????????????????????????????????????????????????????) ;;
		3:rcs_sha256=????????????????????????????????????????????????????????????????)
			storage_rcs_expected_sha256=${storage_root_contract_line#rcs_sha256=} ;;
		4:inittab_sha256=????????????????????????????????????????????????????????????????)
			storage_inittab_expected_sha256=${storage_root_contract_line#inittab_sha256=} ;;
		5:busybox_sha256=????????????????????????????????????????????????????????????????)
			storage_busybox_expected_sha256=${storage_root_contract_line#busybox_sha256=} ;;
		6:sbin_link=usr/sbin) ;;
		7:usr_sbin_init_link=/usr/local/bin/busybox) ;;
		8:rcs_interpreter=/usr/local/bin/busybox\ sh) ;;
		*) return 1 ;;
		esac
		case $storage_root_contract_line in
		*_sha256=*[!0123456789abcdef]*) return 1 ;;
		esac
	done <"$storage_root_contract"
	[ "$storage_root_contract_lines" = 8 ] && [ -n "$storage_rcs_expected_sha256" ] &&
		[ -n "$storage_inittab_expected_sha256" ] && [ -n "$storage_busybox_expected_sha256" ]
}

# Each rejection says which check refused.  "marker or root contract is
# invalid" covers twenty-odd conditions, and narrowing it down otherwise means
# a QEMU round per hypothesis -- which is how this session spent an hour after
# a contract and a device layer drifted apart.
storage_gnome_reject() {
	log "gnome root rejected: $1"
	return 1
}

storage_gnome_root_ok() {
	storage_checked_root=$1
	storage_checked_marker=$storage_checked_root/$storage_marker
	[ -f "$storage_checked_marker" ] && [ ! -L "$storage_checked_marker" ] ||
		storage_gnome_reject "marker missing or a symlink" || return 1
	[ "$("$BB" stat -c '%a %u %g %s' "$storage_checked_marker" 2>/dev/null || true)" = "644 0 0 21" ] ||
		storage_gnome_reject "marker metadata is not 644 0 0 21" || return 1
	[ "$("$BB" sha256sum "$storage_checked_marker" | "$BB" cut -d' ' -f1)" = "$storage_marker_sha256" ] || return 1
	[ -f "$storage_gnome_contract" ] && [ ! -L "$storage_gnome_contract" ] ||
		storage_gnome_reject "contract missing from the initramfs" || return 1
	storage_gnome_contract_size=$("$BB" stat -c '%s' "$storage_gnome_contract" 2>/dev/null || true)
	case $storage_gnome_contract_size in ''|*[!0-9]*) return 1 ;; esac
	# The project-owned closure has more independent enforcement edges than
	# the legacy nine pins.  Keep input bounded while leaving headroom for a
	# reviewed future addition; the generator enforces this same 256..16384 B
	# envelope before an initramfs is built.
	[ "$storage_gnome_contract_size" -ge 256 ] && [ "$storage_gnome_contract_size" -le 16384 ] || return 1
	storage_gnome_lines=0
	while IFS= read -r storage_gnome_line; do
		storage_gnome_lines=$((storage_gnome_lines + 1))
		if [ "$storage_gnome_lines" = 1 ]; then
			[ "$storage_gnome_line" = LIUQIN_GNOME_ROOT_CONTRACT_V1 ] || return 1
			continue
		fi
		storage_gnome_hash=${storage_gnome_line%%  *}
		storage_gnome_path=${storage_gnome_line#*  }
		[ "$storage_gnome_hash  $storage_gnome_path" = "$storage_gnome_line" ] || return 1
		printf '%s\n' "$storage_gnome_hash" | "$BB" grep -Eq '^[0-9a-f]{64}$' || return 1
		case $storage_gnome_path in /*) ;; *) return 1 ;; esac
		case $storage_gnome_path in *'/../'*|*'/..') return 1 ;; esac
		storage_gnome_file=$storage_checked_root$storage_gnome_path
		[ -f "$storage_gnome_file" ] && [ ! -L "$storage_gnome_file" ] ||
			storage_gnome_reject "not a regular file: $storage_gnome_path" || return 1
		[ "$("$BB" stat -c '%u %g' "$storage_gnome_file" 2>/dev/null || true)" = "0 0" ] ||
			storage_gnome_reject "not owned by root: $storage_gnome_path" || return 1
		[ "$("$BB" sha256sum "$storage_gnome_file" | "$BB" cut -d' ' -f1)" = "$storage_gnome_hash" ] ||
			storage_gnome_reject "hash differs from the contract: $storage_gnome_path" || return 1
	done <"$storage_gnome_contract"
	[ "$storage_gnome_lines" -ge 10 ] && [ "$storage_gnome_lines" -le 128 ] || return 1
	# Content hashes alone do not prove that systemd can execute the guard or
	# that the unit is enabled.  These topology/mode gates are deliberately
	# outside the regular-file contract because symlinks have no stable file
	# payload to hash.
	for storage_gnome_executable in \
		/usr/lib/systemd/systemd /usr/sbin/gdm3 /usr/bin/gnome-shell \
		/usr/bin/hexagonrpcd /usr/bin/ssccli \
		/usr/local/bin/busybox /usr/local/bin/liuqin-shell \
		/usr/local/libexec/liuqin-iio-sensor-proxy \
		/usr/local/sbin/liuqin-gnome-storage-guard \
		/usr/local/sbin/liuqin-gnome-usb-rescue \
		/usr/local/libexec/liuqin-power-keyd \
		/usr/local/libexec/liuqin-power-key-action \
		/usr/local/libexec/liuqin-uinput-automation \
		/usr/local/libexec/liuqin-audio-hwparams-probe \
		/usr/local/sbin/liuqin-snap-root-admission \
		/usr/local/sbin/liuqin-bt-public-addr \
		/usr/local/sbin/liuqin-wlan-mac \
		/usr/libexec/liuqin-ssc-sample-gate; do
		[ "$("$BB" stat -c '%a' "$storage_checked_root$storage_gnome_executable" 2>/dev/null || true)" = 755 ] ||
			storage_gnome_reject "not executable: $storage_gnome_executable" || return 1
	done
	for storage_gnome_regular in \
		/etc/dconf/db/local.d/locks/00-liuqin-power \
		/etc/systemd/system/liuqin-gnome-storage-guard.service \
		/etc/systemd/system/liuqin-gnome-usb-rescue.service \
		/etc/systemd/system/liuqin-power-keyd.service \
		/etc/systemd/system/liuqin-snap-root-admission.service \
		/etc/systemd/system/bluetooth.service.d/20-liuqin-public-address.conf \
		/etc/systemd/system/liuqin-bt-preconfigure.service \
		/etc/systemd/system/liuqin-hexagonrpcd-sdsp.service \
		/etc/systemd/system/liuqin-ssc-sample-gate.service \
		/etc/systemd/system/liuqin-sensor-stack.target \
		/etc/systemd/system/liuqin-wlan-mac.service \
		/etc/systemd/system/NetworkManager.service.d/20-liuqin-wlan-mac.conf \
		/etc/udev/rules.d/80-liuqin-fastrpc.rules \
		/usr/lib/firmware/qcom/sm8450/Xiaomi-Pad-6-Pro-tplg.bin \
		/usr/share/qcom/sm8450/Xiaomi/liuqin/sensors/sns_reg_version; do
		[ "$("$BB" stat -c '%a' "$storage_checked_root$storage_gnome_regular" 2>/dev/null || true)" = 644 ] ||
			storage_gnome_reject "project regular-file mode is invalid: $storage_gnome_regular" || return 1
	done
	[ -L "$storage_checked_root/etc/systemd/system/basic.target.requires/liuqin-gnome-storage-guard.service" ] ||
		storage_gnome_reject "storage guard is not required by basic.target" || return 1
	[ "$("$BB" readlink "$storage_checked_root/etc/systemd/system/basic.target.requires/liuqin-gnome-storage-guard.service")" = ../liuqin-gnome-storage-guard.service ] || return 1
	[ -L "$storage_checked_root/etc/systemd/system/basic.target.requires/liuqin-snap-root-admission.service" ] ||
		storage_gnome_reject "Snap admission is not required by basic.target" || return 1
	[ "$("$BB" readlink "$storage_checked_root/etc/systemd/system/basic.target.requires/liuqin-snap-root-admission.service")" = ../liuqin-snap-root-admission.service ] || return 1
	[ -L "$storage_checked_root/etc/systemd/system/multi-user.target.wants/liuqin-gnome-usb-rescue.service" ] ||
		storage_gnome_reject "USB rescue service is not enabled" || return 1
	[ "$("$BB" readlink "$storage_checked_root/etc/systemd/system/multi-user.target.wants/liuqin-gnome-usb-rescue.service")" = ../liuqin-gnome-usb-rescue.service ] || return 1
	[ -L "$storage_checked_root/etc/systemd/system/multi-user.target.wants/liuqin-power-keyd.service" ] ||
		storage_gnome_reject "power-key policy is not enabled" || return 1
	[ "$("$BB" readlink "$storage_checked_root/etc/systemd/system/multi-user.target.wants/liuqin-power-keyd.service")" = ../liuqin-power-keyd.service ] || return 1
	"$BB" grep -qx 'Requires=liuqin-bt-preconfigure.service' \
		"$storage_checked_root/etc/systemd/system/bluetooth.service.d/20-liuqin-public-address.conf" ||
		storage_gnome_reject "Bluetooth preconfiguration is not required by BlueZ" || return 1
	"$BB" grep -qx 'After=liuqin-bt-preconfigure.service' \
		"$storage_checked_root/etc/systemd/system/bluetooth.service.d/20-liuqin-public-address.conf" || return 1
	"$BB" grep -qx 'Before=bluetooth.service' \
		"$storage_checked_root/etc/systemd/system/liuqin-bt-preconfigure.service" || return 1
	"$BB" grep -qx 'ExecStart=/usr/local/sbin/liuqin-bt-public-addr' \
		"$storage_checked_root/etc/systemd/system/liuqin-bt-preconfigure.service" || return 1
	for storage_gnome_obsolete_bt_link in \
		/etc/systemd/system/bluetooth.service.wants/liuqin-bt-public-addr.service \
		/etc/systemd/system/bluetooth.service.requires/liuqin-bt-public-addr.service; do
		[ ! -e "$storage_checked_root$storage_gnome_obsolete_bt_link" ] &&
			[ ! -L "$storage_checked_root$storage_gnome_obsolete_bt_link" ] ||
			storage_gnome_reject "obsolete Bluetooth helper activation remains" || return 1
	done
	[ -L "$storage_checked_root/usr/sbin/init" ] ||
		storage_gnome_reject "/usr/sbin/init is not a symlink" || return 1
	[ "$("$BB" readlink "$storage_checked_root/usr/sbin/init")" = ../lib/systemd/systemd ] || return 1
	[ -L "$storage_checked_root/etc/systemd/system/default.target" ] ||
		storage_gnome_reject "default.target is not a symlink" || return 1
	[ "$("$BB" readlink "$storage_checked_root/etc/systemd/system/default.target")" = /usr/lib/systemd/system/graphical.target ] || return 1
	[ -L "$storage_checked_root/etc/systemd/system/display-manager.service" ] ||
		storage_gnome_reject "display-manager.service is not a symlink" || return 1
	[ "$("$BB" readlink "$storage_checked_root/etc/systemd/system/display-manager.service")" = /lib/systemd/system/gdm3.service ] || return 1
	"$BB" chroot "$storage_checked_root" /usr/lib/systemd/systemd --version >/dev/null 2>&1 ||
		storage_gnome_reject "systemd will not execute under chroot" || return 1
	return 0
}

storage_native_reject() {
	log "native root rejected: $1"
	return 1
}

# Native-install profile:
# the fresh root lives in the native-root subdir of LIUQIN_ROOT and every pinned
# path is project-owned.  Development evidence tools (uinput-automation,
# audio-hwparams-probe, ssccli) and the snap admission text check deliberately
# appear in no gate here: they must not decide whether the system boots.
storage_native_root_ok() {
	storage_checked_root=$1
	storage_checked_marker=$storage_checked_root/$storage_marker
	[ -f "$storage_checked_marker" ] && [ ! -L "$storage_checked_marker" ] ||
		storage_native_reject "marker missing or a symlink" || return 1
	[ "$("$BB" stat -c '%a %u %g %s' "$storage_checked_marker" 2>/dev/null || true)" = "644 0 0 22" ] ||
		storage_native_reject "marker metadata is not 644 0 0 22" || return 1
	[ "$("$BB" sha256sum "$storage_checked_marker" | "$BB" cut -d' ' -f1)" = "$storage_marker_sha256" ] ||
		storage_native_reject "marker content mismatch" || return 1
	[ -f "$storage_native_contract" ] && [ ! -L "$storage_native_contract" ] ||
		storage_native_reject "contract missing from the initramfs" || return 1
	storage_native_contract_size=$("$BB" stat -c '%s' "$storage_native_contract" 2>/dev/null || true)
	case $storage_native_contract_size in ''|*[!0-9]*) return 1 ;; esac
	[ "$storage_native_contract_size" -ge 256 ] && [ "$storage_native_contract_size" -le 16384 ] || return 1
	storage_native_lines=0
	while IFS= read -r storage_native_line; do
		storage_native_lines=$((storage_native_lines + 1))
		if [ "$storage_native_lines" = 1 ]; then
			[ "$storage_native_line" = LIUQIN_NATIVE_ROOT_CONTRACT_V1 ] || return 1
			continue
		fi
		storage_native_hash=${storage_native_line%%  *}
		storage_native_path=${storage_native_line#*  }
		[ "$storage_native_hash  $storage_native_path" = "$storage_native_line" ] || return 1
		printf '%s\n' "$storage_native_hash" | "$BB" grep -Eq '^[0-9a-f]{64}$' || return 1
		case $storage_native_path in /*) ;; *) return 1 ;; esac
		case $storage_native_path in *'/../'*|*'/..') return 1 ;; esac
		storage_native_file=$storage_checked_root$storage_native_path
		[ -f "$storage_native_file" ] && [ ! -L "$storage_native_file" ] ||
			storage_native_reject "not a regular file: $storage_native_path" || return 1
		[ "$("$BB" stat -c '%u %g' "$storage_native_file" 2>/dev/null || true)" = "0 0" ] ||
			storage_native_reject "not owned by root: $storage_native_path" || return 1
		[ "$("$BB" sha256sum "$storage_native_file" | "$BB" cut -d' ' -f1)" = "$storage_native_hash" ] ||
			storage_native_reject "hash differs from the contract: $storage_native_path" || return 1
	done <"$storage_native_contract"
	[ "$storage_native_lines" -ge 10 ] && [ "$storage_native_lines" -le 128 ] || return 1
	for storage_native_executable in \
		/usr/lib/systemd/systemd /usr/sbin/gdm3 /usr/bin/gnome-shell \
		/usr/bin/hexagonrpcd \
		/usr/local/bin/busybox /usr/sbin/liuqin-devmode \
		/usr/libexec/iio-sensor-proxy \
		/usr/local/sbin/liuqin-gnome-storage-guard \
		/usr/libexec/liuqin/devmode-gadget \
		/usr/local/libexec/liuqin-power-keyd \
		/usr/local/libexec/liuqin-power-key-action \
		/usr/local/sbin/liuqin-bt-public-addr \
		/usr/local/sbin/liuqin-wlan-mac \
		/usr/libexec/liuqin-ssc-sample-gate; do
		[ "$("$BB" stat -c '%a' "$storage_checked_root$storage_native_executable" 2>/dev/null || true)" = 755 ] ||
			storage_native_reject "not executable: $storage_native_executable" || return 1
	done
	for storage_native_regular in \
		/etc/dconf/db/local.d/locks/00-liuqin-power \
		/etc/systemd/system/liuqin-gnome-storage-guard.service \
		/usr/lib/systemd/system/liuqin-devmode.service \
		/etc/systemd/system/liuqin-power-keyd.service \
		/etc/systemd/system/liuqin-backlight-default.service \
		/etc/systemd/system/bluetooth.service.d/20-liuqin-public-address.conf \
		/etc/systemd/system/liuqin-bt-preconfigure.service \
		/etc/systemd/system/liuqin-hexagonrpcd-sdsp.service \
		/etc/systemd/system/liuqin-ssc-sample-gate.service \
		/etc/systemd/system/liuqin-sensor-stack.target \
		/etc/systemd/system/liuqin-wlan-mac.service \
		/etc/systemd/system/NetworkManager.service.d/20-liuqin-wlan-mac.conf \
		/etc/udev/rules.d/80-liuqin-fastrpc.rules \
		/usr/lib/firmware/qcom/sm8450/Xiaomi-Pad-6-Pro-tplg.bin \
		/usr/share/qcom/sm8450/Xiaomi/liuqin/sensors/sns_reg_version; do
		[ "$("$BB" stat -c '%a' "$storage_checked_root$storage_native_regular" 2>/dev/null || true)" = 644 ] ||
			storage_native_reject "project regular-file mode is invalid: $storage_native_regular" || return 1
	done
	[ -L "$storage_checked_root/etc/systemd/system/basic.target.requires/liuqin-gnome-storage-guard.service" ] ||
		storage_native_reject "storage guard is not required by basic.target" || return 1
	[ "$("$BB" readlink "$storage_checked_root/etc/systemd/system/basic.target.requires/liuqin-gnome-storage-guard.service")" = ../liuqin-gnome-storage-guard.service ] || return 1
	[ ! -e "$storage_checked_root/etc/systemd/system/basic.target.requires/liuqin-snap-root-admission.service" ] &&
		[ ! -L "$storage_checked_root/etc/systemd/system/basic.target.requires/liuqin-snap-root-admission.service" ] ||
		storage_native_reject "snap admission still gates basic.target" || return 1
	[ -L "$storage_checked_root/etc/systemd/system/multi-user.target.wants/liuqin-power-keyd.service" ] ||
		storage_native_reject "power-key policy is not enabled" || return 1
	[ "$("$BB" readlink "$storage_checked_root/etc/systemd/system/multi-user.target.wants/liuqin-power-keyd.service")" = ../liuqin-power-keyd.service ] || return 1
	[ -L "$storage_checked_root/etc/systemd/system/graphical.target.wants/liuqin-backlight-default.service" ] ||
		storage_native_reject "backlight default is not enabled" || return 1
	[ "$("$BB" readlink "$storage_checked_root/etc/systemd/system/graphical.target.wants/liuqin-backlight-default.service")" = ../liuqin-backlight-default.service ] || return 1
	"$BB" grep -qx 'Requires=liuqin-bt-preconfigure.service' \
		"$storage_checked_root/etc/systemd/system/bluetooth.service.d/20-liuqin-public-address.conf" ||
		storage_native_reject "Bluetooth preconfiguration is not required by BlueZ" || return 1
	"$BB" grep -qx 'After=liuqin-bt-preconfigure.service' \
		"$storage_checked_root/etc/systemd/system/bluetooth.service.d/20-liuqin-public-address.conf" || return 1
	"$BB" grep -qx 'Before=bluetooth.service' \
		"$storage_checked_root/etc/systemd/system/liuqin-bt-preconfigure.service" || return 1
	"$BB" grep -qx 'ExecStart=/usr/local/sbin/liuqin-bt-public-addr' \
		"$storage_checked_root/etc/systemd/system/liuqin-bt-preconfigure.service" || return 1
	for storage_native_obsolete_bt_link in \
		/etc/systemd/system/bluetooth.service.wants/liuqin-bt-public-addr.service \
		/etc/systemd/system/bluetooth.service.requires/liuqin-bt-public-addr.service; do
		[ ! -e "$storage_checked_root$storage_native_obsolete_bt_link" ] &&
			[ ! -L "$storage_checked_root$storage_native_obsolete_bt_link" ] ||
			storage_native_reject "obsolete Bluetooth helper activation remains" || return 1
	done
	[ -L "$storage_checked_root/usr/sbin/init" ] ||
		storage_native_reject "/usr/sbin/init is not a symlink" || return 1
	[ "$("$BB" readlink "$storage_checked_root/usr/sbin/init")" = ../lib/systemd/systemd ] || return 1
	[ -L "$storage_checked_root/etc/systemd/system/default.target" ] ||
		storage_native_reject "default.target is not a symlink" || return 1
	[ "$("$BB" readlink "$storage_checked_root/etc/systemd/system/default.target")" = /usr/lib/systemd/system/graphical.target ] || return 1
	[ -L "$storage_checked_root/etc/systemd/system/display-manager.service" ] ||
		storage_native_reject "display-manager.service is not a symlink" || return 1
	[ "$("$BB" readlink "$storage_checked_root/etc/systemd/system/display-manager.service")" = /lib/systemd/system/gdm3.service ] || return 1
	"$BB" chroot "$storage_checked_root" /usr/lib/systemd/systemd --version >/dev/null 2>&1 ||
		storage_native_reject "systemd will not execute under chroot" || return 1
	return 0
}

storage_root_ok() {
	storage_checked_root=$1
	if [ "$storage_profile" = native ]; then
		storage_native_root_ok "$storage_checked_root"
		return $?
	fi
	if [ "$storage_profile" = gnome ]; then
		storage_gnome_root_ok "$storage_checked_root"
		return $?
	fi
	storage_checked_marker=$storage_checked_root/$storage_marker
	[ -f "$storage_checked_marker" ] || return 1
	[ ! -L "$storage_checked_marker" ] || return 1
	[ "$("$BB" stat -c '%a %u %g %s' "$storage_checked_marker" 2>/dev/null || true)" = "644 0 0 26" ] || return 1
	[ "$("$BB" sha256sum "$storage_checked_marker" 2>/dev/null | "$BB" cut -d' ' -f1)" = "$storage_marker_sha256" ] || return 1
	storage_checked_busybox=$storage_checked_root/usr/local/bin/busybox
	[ -f "$storage_checked_busybox" ] || return 1
	[ ! -L "$storage_checked_busybox" ] || return 1
	[ "$("$BB" stat -c '%a %u %g' "$storage_checked_busybox" 2>/dev/null || true)" = "755 0 0" ] || return 1
	storage_checked_inittab=$storage_checked_root/etc/inittab
	[ -f "$storage_checked_inittab" ] || return 1
	[ ! -L "$storage_checked_inittab" ] || return 1
	[ "$("$BB" stat -c '%a %u %g' "$storage_checked_inittab" 2>/dev/null || true)" = "644 0 0" ] || return 1
	storage_root_contract_ok || return 1
	storage_checked_rcs=$storage_checked_root/etc/init.d/rcS
	[ -f "$storage_checked_rcs" ] || return 1
	[ ! -L "$storage_checked_rcs" ] || return 1
	[ "$("$BB" stat -c '%a %u %g' "$storage_checked_rcs" 2>/dev/null || true)" = "755 0 0" ] || return 1
	[ "$("$BB" sha256sum "$storage_checked_rcs" 2>/dev/null | "$BB" cut -d' ' -f1)" = "$storage_rcs_expected_sha256" ] || return 1
	[ "$("$BB" sha256sum "$storage_checked_inittab" 2>/dev/null | "$BB" cut -d' ' -f1)" = "$storage_inittab_expected_sha256" ] || return 1
	[ "$("$BB" sha256sum "$storage_checked_busybox" 2>/dev/null | "$BB" cut -d' ' -f1)" = "$storage_busybox_expected_sha256" ] || return 1
	[ "$("$BB" head -n 1 "$storage_checked_rcs" 2>/dev/null || true)" = '#!/usr/local/bin/busybox sh' ] || return 1
	storage_checked_sbin=$storage_checked_root/sbin
	[ -L "$storage_checked_sbin" ] || return 1
	[ "$("$BB" readlink "$storage_checked_sbin" 2>/dev/null || true)" = usr/sbin ] || return 1
	[ "$("$BB" stat -c '%a %u %g' "$storage_checked_sbin" 2>/dev/null || true)" = "777 0 0" ] || return 1
	storage_checked_init=$storage_checked_root/usr/sbin/init
	[ -L "$storage_checked_init" ] || return 1
	[ "$("$BB" readlink "$storage_checked_init" 2>/dev/null || true)" = /usr/local/bin/busybox ] || return 1
	[ "$("$BB" stat -c '%a %u %g' "$storage_checked_init" 2>/dev/null || true)" = "777 0 0" ] || return 1
	"$BB" chroot "$storage_checked_root" /usr/local/bin/busybox true || return 1
	"$BB" chroot "$storage_checked_root" /usr/local/bin/busybox test -x /sbin/init || return 1
	# This is the rcS interpreter itself, not merely the PID 1 target.  The
	# preceding digest binds its bytes; executing its `sh` applet proves the
	# statically pinned BusyBox can supply the kernel shebang interpreter.
	"$BB" chroot "$storage_checked_root" /usr/local/bin/busybox sh -c \
		'test -x /etc/init.d/rcS' || return 1
	return 0
}

storage_collect_sd_nodes() {
	storage_nodes_root=${1:-$storage_dev_root}
	storage_collected_nodes=
	for storage_block in "$storage_nodes_root"/sd*; do
		[ -e "$storage_block" ] || [ -L "$storage_block" ] || continue
		storage_path_is_block "$storage_block" || return 1
		[ "$("$BB" readlink -f "$storage_block" 2>/dev/null || true)" = "$storage_block" ] || return 1
		storage_node_name=${storage_block##*/}
		if [ -n "$storage_collected_nodes" ]; then
			storage_collected_nodes="$storage_collected_nodes
$storage_node_name"
		else
			storage_collected_nodes=$storage_node_name
		fi
	done
	[ -n "$storage_collected_nodes" ] || return 1
	printf '%s\n' "$storage_collected_nodes"
}

storage_snapshot_sd_nodes() {
	storage_sd_nodes_snapshot=$(storage_collect_sd_nodes) || return 1
	storage_snapshot_has_parent=false
	storage_snapshot_has_target=false
	storage_snapshot_has_home=false
	for storage_block in $storage_sd_nodes_snapshot; do
		[ "$storage_block" != sda ] || storage_snapshot_has_parent=true
		[ "$storage_block" != "$storage_target_name" ] || storage_snapshot_has_target=true
		[ -z "$storage_home_name" ] || [ "$storage_block" != "$storage_home_name" ] ||
			storage_snapshot_has_home=true
	done
	[ "$storage_snapshot_has_parent" = true ] && [ "$storage_snapshot_has_target" = true ] || return 1
	if [ -n "$storage_home_name" ] && [ "$storage_snapshot_has_home" != true ]; then
		log "persistent home left the UFS node set after resolution; it stays read-only"
		storage_home_name=
		storage_home=
	fi
	storage_sd_nodes_snapshot_taken=true
}

storage_lock_all() {
	# Do not treat an empty glob as proof that storage is safe. In particular,
	# a persistent-root rejection before UFS enumeration must not unlock the RAM
	# rescue services merely because there was nothing for the loops to inspect.
	storage_lock_ok=true
	storage_lock_seen=false
	storage_lock_namespace_ok=true
	if storage_lock_nodes=$(storage_collect_sd_nodes "$storage_dev_root"); then
		:
	else
		storage_lock_namespace_ok=false
	fi
	for storage_path in "$storage_dev_root"/sd*; do
		storage_path_is_block "$storage_path" || continue
		storage_lock_seen=true
		"$BB" blockdev --setro "$storage_path" 2>/dev/null || storage_lock_ok=false
	done
	[ "$storage_lock_seen" = true ] || return 1
	for storage_path in "$storage_dev_root"/sd*; do
		storage_path_is_block "$storage_path" || continue
		[ "$("$BB" blockdev --getro "$storage_path" 2>/dev/null || true)" = 1 ] || storage_lock_ok=false
	done
	if storage_lock_nodes_verified=$(storage_collect_sd_nodes "$storage_dev_root"); then
		[ "$storage_lock_nodes_verified" = "$storage_lock_nodes" ] || storage_lock_namespace_ok=false
	else
		storage_lock_namespace_ok=false
	fi
	[ "$storage_lock_ok" = true ] && [ "$storage_lock_namespace_ok" = true ]
}

storage_snapshot_all_ro() {
	[ "$storage_sd_nodes_snapshot_taken" = true ] || return 0
	storage_sd_nodes_current=$(storage_collect_sd_nodes "$storage_dev_root") || return 1
	[ "$storage_sd_nodes_current" = "$storage_sd_nodes_snapshot" ] || return 1
	storage_path_is_block "$storage_parent" || return 1
	storage_path_is_block "$storage_target" || return 1
	[ "$("$BB" readlink -f "$storage_parent" 2>/dev/null || true)" = "$storage_parent" ] || return 1
	[ "$("$BB" readlink -f "$storage_target" 2>/dev/null || true)" = "$storage_target" ] || return 1
	for storage_block in $storage_sd_nodes_snapshot; do
		[ "$("$BB" blockdev --getro "$storage_dev_root/$storage_block" 2>/dev/null || true)" = 1 ] || return 1
	done
	return 0
}

# The snapshot is the pre-open canonical device namespace.  Re-check it at
# every point at which a successful persistent boot would otherwise continue:
# before mounting rw, after that mount, and immediately before switch_root.
storage_snapshot_persistent_ok() {
	storage_nodes_root=${1:-$storage_dev_root}
	[ "$storage_sd_nodes_snapshot_taken" = true ] || return 1
	storage_sd_nodes_current=$(storage_collect_sd_nodes "$storage_nodes_root") || return 1
	[ "$storage_sd_nodes_current" = "$storage_sd_nodes_snapshot" ] || return 1
	storage_check_parent=$storage_nodes_root/sda
	storage_check_target=$storage_nodes_root/$storage_target_name
	storage_path_is_block "$storage_check_parent" || return 1
	storage_path_is_block "$storage_check_target" || return 1
	[ "$("$BB" readlink -f "$storage_check_parent" 2>/dev/null || true)" = "$storage_check_parent" ] || return 1
	[ "$("$BB" readlink -f "$storage_check_target" 2>/dev/null || true)" = "$storage_check_target" ] || return 1
	[ "$("$BB" blockdev --getro "$storage_check_parent" 2>/dev/null || true)" = 0 ] || return 1
	[ "$("$BB" blockdev --getro "$storage_check_target" 2>/dev/null || true)" = 0 ] || return 1
	# The home partition, when one was resolved, is the third and last node
	# this boot is allowed to leave writable.
	if [ -n "$storage_home_name" ]; then
		storage_check_home=$storage_nodes_root/$storage_home_name
		storage_path_is_block "$storage_check_home" || return 1
		[ "$("$BB" readlink -f "$storage_check_home" 2>/dev/null || true)" = "$storage_check_home" ] || return 1
		[ "$("$BB" blockdev --getro "$storage_check_home" 2>/dev/null || true)" = 0 ] || return 1
	fi
	for storage_block in $storage_sd_nodes_snapshot; do
		case $storage_block in sda|"$storage_target_name") continue ;; esac
		if [ -n "$storage_home_name" ] && [ "$storage_block" = "$storage_home_name" ]; then
			continue
		fi
		[ "$("$BB" blockdev --getro "$storage_nodes_root/$storage_block" 2>/dev/null || true)" = 1 ] || return 1
	done
	return 0
}

storage_abort() {
	storage_unmount_ok=true
	if [ "$storage_root_mounted" = true ]; then
		if "$BB" umount "$storage_newroot" 2>/dev/null; then
			storage_root_mounted=false
		else
			storage_unmount_ok=false
		fi
	fi
	if [ "$storage_probe_mounted" = true ]; then
		if "$BB" umount "$storage_probe_root" 2>/dev/null; then
			storage_probe_mounted=false
		else
			storage_unmount_ok=false
		fi
	fi
	storage_lock_ok=true
	# storage_lock_all seals every /dev/sd* node, so the home partition is
	# re-sealed with the rest; forget it as well, so no later check can treat
	# a rejected boot's home partition as one that may stay writable.
	storage_home_name=
	storage_home=
	storage_lock_all || storage_lock_ok=false
	storage_snapshot_all_ro || storage_lock_ok=false
	if [ "$storage_unmount_ok" = true ] && [ "$storage_lock_ok" = true ]; then
		storage_fallback_safe=true
		log "persistent root rejected; all UFS devices are read-only again"
		return 0
	fi
	storage_fallback_safe=false
	log "critical: persistent root could not be unmounted and relocked"
	return 1
}

storage_prepare_persistent_root() {
	storage_identity_ok || {
		log "persistent root identity/label check failed"
		storage_abort
		return 1
	}

	"$BB" mkdir -p "$storage_probe_root" "$storage_newroot"
	if ! "$BB" mount -t ext4 -o ro,noload "$storage_target" "$storage_probe_root"; then
		log "persistent root failed its read-only ext4 mount"
		storage_abort
		return 1
	fi
	storage_probe_mounted=true
	storage_probe_checked_root=$storage_probe_root
	[ -z "$storage_root_subdir" ] || storage_probe_checked_root=$storage_probe_root/$storage_root_subdir
	if ! storage_root_ok "$storage_probe_checked_root"; then
		log "persistent root marker or root contract is invalid"
		storage_abort
		return 1
	fi
	if ! "$BB" umount "$storage_probe_root"; then
		log "persistent root read-only probe could not be unmounted"
		storage_abort
		return 1
	fi
	storage_probe_mounted=false
	if ! storage_snapshot_sd_nodes; then
		log "persistent root UFS node snapshot is invalid"
		storage_abort
		return 1
	fi

	# A partition cannot be writable while its parent disk remains read-only.
	# Open exactly that necessary pair, then immediately reassert read-only on
	# every sibling partition and every other UFS LUN.
	"$BB" blockdev --setrw "$storage_parent" || {
		log "persistent root parent could not be opened"
		storage_abort
		return 1
	}
	"$BB" blockdev --setrw "$storage_target" || {
		log "persistent root target could not be opened"
		storage_abort
		return 1
	}
	# The home partition is opened at exactly the same point, for the same
	# reason: the flag is kernel state that outlives this initramfs.  A
	# refused BLKROSET here is not fatal -- it leaves the partition in the
	# sealed baseline -- so drop it from the writable set and continue.
	if [ -n "$storage_home" ]; then
		if "$BB" blockdev --setrw "$storage_home"; then
			log "persistent home opened read-write for the real root's fstab: $storage_home"
		else
			log "persistent home could not be opened; it stays read-only: $storage_home"
			storage_home_name=
			storage_home=
		fi
	fi
	for storage_block in "$storage_dev_root"/sd*; do
		storage_path_is_block "$storage_block" || continue
		case $storage_block in
			"$storage_parent"|"$storage_target") continue ;;
		esac
		if [ -n "$storage_home" ] && [ "$storage_block" = "$storage_home" ]; then
			continue
		fi
		"$BB" blockdev --setro "$storage_block" 2>/dev/null || {
			log "persistent root sibling could not be kept read-only: $storage_block"
			storage_abort
			return 1
		}
	done
	if ! storage_snapshot_persistent_ok "$storage_dev_root"; then
		log "persistent root UFS state changed before its read-write mount"
		storage_abort
		return 1
	fi

	if [ -z "$storage_root_subdir" ]; then
		if ! "$BB" mount -t ext4 -o rw,noatime "$storage_target" "$storage_newroot"; then
			log "persistent root failed its read-write ext4 mount"
			storage_abort
			return 1
		fi
		storage_root_mounted=true
	else
		if ! "$BB" mount -t ext4 -o rw,noatime "$storage_target" "$storage_probe_root"; then
			log "persistent volume failed its read-write ext4 mount"
			storage_abort
			return 1
		fi
		storage_probe_mounted=true
		if ! "$BB" mount --bind "$storage_probe_root/$storage_root_subdir" "$storage_newroot"; then
			log "persistent GNOME subroot bind failed"
			storage_abort
			return 1
		fi
		storage_root_mounted=true
		if ! "$BB" umount "$storage_probe_root"; then
			log "persistent volume could not detach after subroot bind"
			storage_abort
			return 1
		fi
		storage_probe_mounted=false
	fi
	if ! storage_root_ok "$storage_newroot"; then
		log "persistent root changed between read-only and read-write validation"
		storage_abort
		return 1
	fi
	if ! storage_snapshot_persistent_ok "$storage_dev_root"; then
		log "persistent root UFS state changed after its read-write mount"
		storage_abort
		return 1
	fi
	return 0
}

# LIUQIN_HOME (the optional linux_home partition) is deliberately NOT mounted
# here.  The initramfs mounts exactly what it must verify before switch_root --
# the root filesystem -- and everything it mounts it also has to move across
# the switch and unwind on every failure path.  /home has no admission contract,
# no marker and nothing in stage 1 needs it, so adding it would buy a second
# ordering and rollback problem for nothing.  systemd in the real root mounts it
# from /etc/fstab (the installer writes the LABEL=LIUQIN_HOME entry); if that
# partition is missing or unlabelled the boot still reaches a shell with an empty
# /home instead of failing in the initramfs.  What the initramfs does owe it is
# the BLKROSET flag: storage_prepare_persistent_root clears it alongside the
# root's, because systemd cannot mount a write-protected block device
# read-write however correct the fstab entry is.
storage_switch_persistent_root() {
	if ! storage_snapshot_persistent_ok "$storage_dev_root"; then
		log "persistent root UFS state changed before switch_root"
		storage_abort || ufs_safe=false
		return 1
	fi
	mkdir -p "$storage_newroot/proc" "$storage_newroot/sys" \
		"$storage_newroot/dev"
	log "persistent root accepted: switching to LIUQIN_ROOT"

	# This sysfs instance, including the covered OF export, moves into the
	# real root. PID1 must see it before its first virtualization query.
	if ! liuqin-physical-platform /sys; then
		log "persistent root physical-platform policy failed"
		storage_abort || ufs_safe=false
		return 1
	fi

	storage_moved=
	storage_move_failed=false
	for storage_mountpoint in /proc /sys /dev; do
		if mount -o move "$storage_mountpoint" \
			"$storage_newroot$storage_mountpoint"; then
			storage_moved="$storage_mountpoint $storage_moved"
		else
			storage_move_failed=true
			break
		fi
	done
	if [ "$storage_move_failed" = true ]; then
		for storage_mountpoint in $storage_moved; do
			mount -o move "$storage_newroot$storage_mountpoint" \
				"$storage_mountpoint" 2>/dev/null || true
		done
		log "persistent root could not receive the kernel filesystems"
		storage_abort || ufs_safe=false
		return 1
	fi

	# The stage-1 DHCP daemon has the deleted initramfs as its root after
	# switch_root. Kill it only after every fallible move completed. Run the
	# new root's BusyBox under chroot because /proc has already moved there.
	if [ -f /run/udhcpd.pid ]; then
		kill "$(cat /run/udhcpd.pid)" 2>/dev/null || true
	fi
	chroot "$storage_newroot" /usr/local/bin/busybox \
		killall telnetd udhcpd 2>/dev/null || true
	if ! storage_snapshot_persistent_ok "$storage_newroot/dev"; then
		log "persistent root UFS state changed immediately before switch_root"
		# /dev has moved, so restore it before the normal abort path tries to
		# unmount/relock the rejected root.
		mount -o move "$storage_newroot/dev" /dev 2>/dev/null || true
		mount -o move "$storage_newroot/sys" /sys 2>/dev/null || true
		mount -o move "$storage_newroot/proc" /proc 2>/dev/null || true
		storage_abort || ufs_safe=false
		return 1
	fi
	# switch_root must itself be PID 1.  Execute the pinned initramfs BusyBox in
	# place: if its final handoff fails or returns, PID 1 dies and the kernel
	# panics rather than allowing this writable half-handoff to resume any RAM
	# rescue service.
	log "persistent root handoff: profile=$storage_profile pid=$$ exec=$BB switch_root $storage_newroot $storage_init"
	exec "$BB" switch_root "$storage_newroot" "$storage_init"
}

# Wait for all six observed UFS LUNs and their GPT tails, not a fixed delay.
# A partition scan creates nodes in table order. The immutable LUN tails and
# the selected data-layout tail must be present before taking the RO snapshot.
storage_ufs_ready() {
	for storage_lun in sda sdb sdc sdd sde sdf; do
		storage_path_is_block "$storage_dev_root/$storage_lun" || return 1
	done
	for storage_tail in sda34 sdb6 sdc6 sdd6 sde77 sdf7; do
		storage_path_is_block "$storage_dev_root/$storage_tail" || return 1
		[ -f "$storage_sys_block/$storage_tail/partition" ] || return 1
	done
	# Both stock/legacy userdata and the installed split layout are supported.
	if storage_path_is_block "$storage_dev_root/sda37"; then
		"$BB" grep -qx PARTNAME=linux_home "$storage_sys_block/sda37/uevent" || return 1
		storage_path_is_block "$storage_dev_root/sda36" || return 1
		"$BB" grep -qx PARTNAME=linux_root "$storage_sys_block/sda36/uevent" || return 1
	else
		storage_path_is_block "$storage_dev_root/sda35" || return 1
		"$BB" grep -qx PARTNAME=userdata "$storage_sys_block/sda35/uevent" || return 1
	fi
	# sysfs may be ahead of mdev. Never stop with a known block node missing.
	for storage_info in "$storage_sys_block"/sd*/dev; do
		[ -f "$storage_info" ] || continue
		storage_node=${storage_info%/dev}; storage_node=${storage_node##*/}
		storage_path_is_block "$storage_dev_root/$storage_node" || return 1
	done
}

storage_wait_ufs() {
	storage_waited=0
	while :; do
		"$BB" mdev -s
		# Seal new arrivals on every scan, including the final timeout scan.
		for storage_node in "$storage_dev_root"/sd*; do
			storage_path_is_block "$storage_node" || continue
			"$BB" blockdev --setro "$storage_node" || return 1
		done
		if storage_ufs_ready; then
			log "UFS LUNs and partitions ready after $storage_waited polls"
			return 0
		fi
		[ "$storage_waited" -lt 100 ] || { log "UFS readiness timed out"; return 1; }
		"$BB" sleep 0.1
		storage_waited=$((storage_waited + 1))
	done
}

# The mutation test enters only the storage gate.  It uses an isolated fake
# /dev, sysfs and command PATH, and never reaches the real init sequence.
if [ "${LIUQIN_INIT_STORAGE_TEST_ONLY:-0}" = 1 ]; then
	if [ "${LIUQIN_INIT_STORAGE_TEST_PHASE:-}" = wait-ufs ]; then
		storage_wait_ufs; exit $?
	fi
	storage_mode=persistent
	if storage_prepare_persistent_root; then
		case ${LIUQIN_INIT_STORAGE_TEST_PHASE:-prepare} in
		prepare) exit 0 ;;
		switch)
			storage_switch_persistent_root
			exit $? ;;
		*) exit 125 ;;
		esac
	fi
	[ "$storage_fallback_safe" = true ] && exit 1
	exit 125
fi

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev 2>/dev/null || true
mkdir -p /dev/pts /run /sys/kernel/config /sys/fs/pstore
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /run
mount -t configfs configfs /sys/kernel/config
mount -t pstore pstore /sys/fs/pstore 2>/dev/null || true

hostname liuqin-firstboot
[ ! -w /proc/sys/kernel/hotplug ] || echo /sbin/mdev >/proc/sys/kernel/hotplug
mdev -s

log "waiting for the expected UFS LUNs and partitions"
found_block=false
storage_wait_ufs && found_block=true

ufs_safe=false
if [ "$found_block" != true ]; then
	log "critical: no SCSI/UFS block devices detected; UFS is not fail-closed"
elif storage_lock_all; then
	ufs_safe=true
	for blockdev_path in /dev/sd*; do
		[ -b "$blockdev_path" ] || continue
		log "verified read-only: $blockdev_path"
	done
else
	log "critical: could not prove every SCSI/UFS block device read-only"
fi

if [ "$ufs_safe" != true ]; then
	log "critical: remote shell will remain disabled because UFS is not fail-closed"
fi

# ABL uses androidboot.mode=charger when external power wakes a deeply
# discharged tablet.  A normal desktop boot in that state consumes more than
# an SDP input can supply and creates a boot/drain/reboot loop.  Product GNOME
# images therefore divert here, before USB gadget setup, any read-write mount,
# slot metadata update, or stage-2/systemd handoff.  The charger process keeps
# retrying the read-only/low-power proof and never turns a failed proof into a
# normal boot.
charger_boot=false
case " $(cat /proc/cmdline 2>/dev/null) " in
*' androidboot.mode=charger '*) charger_boot=true ;;
esac
if { [ "$storage_profile" = gnome ] || [ "$storage_profile" = native ]; } && [ "$charger_boot" = true ]; then
	charger_marker=/etc/liuqin-charger-mode
	charger_marker_ok=false
	charger_marker_hash=$(sha256sum "$charger_marker" 2>/dev/null | cut -d' ' -f1)
	if [ -f "$charger_marker" ] && [ ! -L "$charger_marker" ] &&
		[ "$(stat -c '%a %u %g %s' "$charger_marker" 2>/dev/null || true)" = "644 0 0 8" ] &&
		[ "$charger_marker_hash" = 837fa926ba93f4a56e06d7e511f782465cebb250f67d74faee1d16bfc80aede1 ] &&
		[ -x /bin/liuqin-charger-mode ] &&
		[ -x /bin/liuqin-charger-mode-power-key ] &&
		[ -x /bin/liuqin-charger-mode-exit ]; then
		charger_marker_ok=true
	fi
	if [ "$charger_marker_ok" = true ]; then
		log "charger boot: entering read-only low-power hold before stage 2"
		exec /bin/liuqin-charger-mode
		log "critical: charger-mode process returned; refusing normal boot"
	else
		log "critical: charger boot lacks its exact low-power state machine; refusing normal boot"
	fi
	# PID 1 must stay alive even if a damaged helper cannot exec.  Never fall
	# through to gadget setup, persistent-root preparation, or GNOME.
	while :; do sleep 60; done
fi

if [ "$storage_mode" = readonly ] && [ -f "$storage_installer_marker" ]; then
gadget=/sys/kernel/config/usb_gadget/liuqin
mkdir -p "$gadget"
echo 0x1d6b >"$gadget/idVendor"
echo 0x1040 >"$gadget/idProduct"
echo 0x0100 >"$gadget/bcdDevice"
echo 0x0200 >"$gadget/bcdUSB"

mkdir -p "$gadget/strings/0x409"
echo 000000000001 >"$gadget/strings/0x409/serialnumber"
echo "Xiaomi Pad 6 Pro mainline" >"$gadget/strings/0x409/manufacturer"
echo "liuqin first-boot diagnostics" >"$gadget/strings/0x409/product"

mkdir -p "$gadget/configs/c.1/strings/0x409"
echo "USB network diagnostics" >"$gadget/configs/c.1/strings/0x409/configuration"
# Configfs MaxPower is expressed in mA.  This gadget is currently limited to
# USB2 high-speed, whose SDP ceiling is 500 mA.  The old 250 mA declaration was
# lower than the ~397 mA ADSP actually accepted and made the descriptor lie;
# 500 fixes that contract but does not override the host/BC1.2/Type-C decision.
echo 500 >"$gadget/configs/c.1/MaxPower"

function_name=ncm.usb0
if ! mkdir "$gadget/functions/$function_name" 2>/dev/null; then
	function_name=ecm.usb0
	mkdir "$gadget/functions/$function_name"
fi
echo 02:00:00:00:07:02 >"$gadget/functions/$function_name/dev_addr"
echo 02:00:00:00:07:01 >"$gadget/functions/$function_name/host_addr"
ln -s "$gadget/functions/$function_name" "$gadget/configs/c.1/$function_name"

udc_name=
for udc_path in /sys/class/udc/*; do
	[ -e "$udc_path" ] || continue
	udc_name=$(basename "$udc_path")
	break
done

# OTG dual-role wiring takes the port role from UCSI on the ADSP, which is not
# running in this RAM image, so no role arrives and no UDC registers here.
# The rescue channel is always the peripheral side; claim that role from the
# switch explicitly.  UCSI takes the port back over after switch_root, so an
# attached OTG host device still gets host mode in the booted desktop.
if [ -z "$udc_name" ]; then
	for role_path in /sys/class/usb_role/*/role; do
		[ -w "$role_path" ] || continue
		echo device >"$role_path" 2>/dev/null || true
	done
	for attempt in 1 2 3 4 5; do
		for udc_path in /sys/class/udc/*; do
			[ -e "$udc_path" ] || continue
			udc_name=$(basename "$udc_path")
			break
		done
		[ -n "$udc_name" ] && break
		sleep 1
	done
fi

# boot_a/boot_b/persist are the partitions the installer host side needs before
# it will do anything, so a missing one is still fatal.  The data partitions are
# not: a Linux-only install (--android-size 0) deletes userdata, and
# linux_root/linux_home exist only after a layout has been written.  Refusing on
# those would leave exactly the install that needs --restore-partition-table
# without the telnet channel to run it from.  An optional partition that does
# exist is held to the same standard as a required one -- resolvable to a single
# block node and still read-only -- because a writable node here means the
# fail-closed baseline did not take.
storage_installer_required='boot_a boot_b persist'
storage_installer_optional='userdata linux_root linux_home'

start_stage1_telnet() {
	[ "$storage_mode" = readonly ] && [ -f "$storage_installer_marker" ] || return 1
	if [ "$ufs_safe" = true ]; then
		if [ -f "$storage_installer_marker" ]; then
			mkdir -p "$storage_dev_root/disk/by-partlabel" || return 1
			storage_installer_linked=
			for label in $storage_installer_required $storage_installer_optional; do
				target=
				for info in "$storage_sys_block"/sd*/uevent; do
					if "$BB" grep -qx "PARTNAME=$label" "$info"; then
						[ -z "$target" ] || { log "duplicate installer partition: $label"; return 1; }
						node=${info%/uevent}; node=${node##*/}
						target=$storage_dev_root/$node
					fi
				done
				if [ -z "$target" ]; then
					case " $storage_installer_optional " in
					*" $label "*) continue ;;
					esac
				fi
				[ -n "$target" ] && storage_path_is_block "$target" &&
					[ "$("$BB" blockdev --getro "$target")" = 1 ] || {
						log "installer partition missing or writable: $label"; return 1;
					}
				ln -s "$target" "$storage_dev_root/disk/by-partlabel/$label" || return 1
				case " $storage_installer_optional " in
				*" $label "*) storage_installer_linked="$storage_installer_linked $label" ;;
				esac
			done
			log "installer data partitions linked:${storage_installer_linked:- none}"
		fi
		log "development-only unauthenticated shell: telnet 192.168.7.2 2323"
		telnetd -b 192.168.7.2:2323 -l /bin/sh
	else
		log "remote shell withheld; inspect the local console for UFS failures"
	fi
}

if [ -n "$udc_name" ]; then
	echo "$udc_name" >"$gadget/UDC"
	for attempt in 1 2 3 4 5; do
		[ -e /sys/class/net/usb0 ] && break
		sleep 1
	done
	if [ -e /sys/class/net/usb0 ]; then
		ip link set usb0 up
		ip address add 192.168.7.2/24 dev usb0
		log "USB $function_name ready at 192.168.7.2/24"

		# A host without administrator rights cannot assign a static address to
		# the new USB interface, so hand one out. No router and no DNS option is
		# offered, which keeps the host from routing anything through the tablet.
		cat >/run/udhcpd.conf <<-EOF
			start 192.168.7.10
			end 192.168.7.19
			interface usb0
			lease_file /run/udhcpd.leases
			pidfile /run/udhcpd.pid
			max_leases 10
			option subnet 255.255.255.0
		EOF
		: >/run/udhcpd.leases
		if udhcpd /run/udhcpd.conf 2>/dev/null; then
			log "udhcpd is serving 192.168.7.10-19 on usb0"
		else
			log "warning: udhcpd did not start; the host must configure 192.168.7.1/24 itself"
		fi

		if [ "$storage_mode" = persistent ]; then
			log "persistent root probe precedes the development shell"
		else
			start_stage1_telnet
		fi
	else
		log "warning: UDC bound but usb0 did not appear"
	fi
else
	log "warning: no UDC found; USB networking unavailable"
fi

fi # dedicated RAM installer USB channel

if [ "$storage_mode" = persistent ] && [ "$ufs_safe" = true ]; then
	if storage_prepare_persistent_root; then
		slot_success_ok=true
		# Mark the slot this boot actually came from.  The dual layout
		# boots Ubuntu from slot A and only reaches slot B when the
		# bootloader has fallen back to the copy kept in boot_b; the
		# Linux-only layout boots it from slot B.  So the suffix -- not a
		# constant -- decides.  A cmdline without a usable suffix means the
		# ABL A/B state cannot be reasoned about, and a persistent handoff
		# that never marks the slot successful would be rolled back by the
		# retry counter: refuse instead.
		if slot_from_cmdline "$(cat /proc/cmdline)"; then
			if /bin/liuqin-mark-slot-successful --check "$slot_suffix"; then
				log "persistent root release: slot $slot_suffix was already successful"
			elif /bin/liuqin-mark-slot-successful --mark "$slot_suffix" &&
				/bin/liuqin-mark-slot-successful --check "$slot_suffix"; then
				log "persistent root release: slot $slot_suffix marked successful"
			else
				log "critical: persistent root is valid but slot $slot_suffix success check/update failed"
				slot_success_ok=false
			fi
		else
			log "critical: refusing a persistent root handoff without a usable androidboot.slot_suffix"
			slot_success_ok=false
		fi
		if [ "$slot_success_ok" != true ]; then
			storage_abort || ufs_safe=false
		elif ! storage_switch_persistent_root; then
			if [ "$storage_fallback_safe" = true ]; then
				storage_lock_all || ufs_safe=false
			else
				ufs_safe=false
			fi
		fi
	else
		# storage_abort restores read-only storage. Recovery requires an explicit
		# fastboot boot of the installer; never open a shell on a failed boot.
		if [ "$storage_fallback_safe" = true ]; then
			storage_lock_all || ufs_safe=false
		else
			ufs_safe=false
		fi
	fi
fi

# ---------------------------------------------------------------------------
# Stage 2: hand the root filesystem over to Ubuntu Base 26.04.
#
# The whole root lives in RAM and no block device is ever mounted: the initramfs
# carries /rootfs.squashfs, which becomes the read-only lower layer of an
# overlay whose upper layer is a tmpfs. That is the *only* way to get a real
# distribution onto this tablet without writing to it.
#
# Everything above stays exactly as it was, and everything below is optional:
# any failure here returns and leaves the diagnostic shell and the telnet
# channel of the previous images untouched, so the device is never less
# debuggable than it was. Stage 2 is also gated on the read-only guard having
# passed -- if UFS is not fail-closed we do not go looking for a nicer shell, we
# stop where the evidence is.
# ---------------------------------------------------------------------------

loopdev=

stage2_cleanup() {
	umount /newroot 2>/dev/null || true
	umount /mnt/rw 2>/dev/null || true
	umount /mnt/lower 2>/dev/null || true
	if [ -n "$loopdev" ]; then
		losetup -d "$loopdev" 2>/dev/null || true
		loopdev=
	fi
}

stage2() {
	rootfs_image=/rootfs.squashfs

	if [ ! -f "$rootfs_image" ]; then
		log "stage 2: $rootfs_image is not in this initramfs"
		return 1
	fi

	mkdir -p /mnt/lower /mnt/rw /newroot

	# An explicit loop device is worth the two extra lines: it names the thing
	# in dmesg and in /proc/mounts, so a squashfs that fails to mount is
	# distinguishable from one that was never attached.
	loopdev=$(losetup -f 2>/dev/null || true)
	if [ -n "$loopdev" ] && losetup -r "$loopdev" "$rootfs_image" 2>/dev/null; then
		log "stage 2: $rootfs_image attached to $loopdev"
		mount_source=$loopdev
		mount_options=ro
	else
		loopdev=
		log "stage 2: no free loop device; letting mount find one"
		mount_source=$rootfs_image
		mount_options=ro,loop
	fi

	if ! mount -t squashfs -o "$mount_options" "$mount_source" /mnt/lower; then
		log "stage 2: cannot mount the squashfs (is CONFIG_SQUASHFS_ZSTD=y?)"
		stage2_cleanup
		return 1
	fi
	# /sbin and /usr/sbin/init are both symlinks in this image and the second
	# one is absolute, so -e on /mnt/lower/sbin/init would resolve against the
	# *initramfs* root and always say no. Test what can be tested from here; the
	# chroot probe further down tests the rest from inside the new root.
	if [ ! -x /mnt/lower/usr/local/bin/busybox ] || [ ! -e /mnt/lower/etc/inittab ]; then
		log "stage 2: the squashfs has no BusyBox or no /etc/inittab"
		stage2_cleanup
		return 1
	fi

	if ! mount -t tmpfs tmpfs /mnt/rw; then
		log "stage 2: cannot mount the writable tmpfs layer"
		stage2_cleanup
		return 1
	fi
	mkdir -p /mnt/rw/upper /mnt/rw/work

	if ! mount -t overlay overlay \
		-o lowerdir=/mnt/lower,upperdir=/mnt/rw/upper,workdir=/mnt/rw/work \
		/newroot; then
		log "stage 2: cannot mount the overlay (is CONFIG_OVERLAY_FS=y, not =m?)"
		stage2_cleanup
		return 1
	fi

	# The squashfs already carries BusyBox; copy ours in only if it somehow
	# does not, so that stage 2 never depends on a single build step.
	if [ ! -x /newroot/usr/local/bin/busybox ]; then
		mkdir -p /newroot/usr/local/bin
		cp /bin/busybox /newroot/usr/local/bin/busybox
		chmod 0755 /newroot/usr/local/bin/busybox
		log "stage 2: supplied BusyBox from the initramfs"
	fi

	# switch_root execs from PID 1, so a failed exec kills init and panics the
	# kernel -- there is no catching it afterwards. Run the new root's BusyBox
	# under chroot first: that exercises the same file through the same overlay,
	# and a wrong architecture, a broken image or a missing binary fails here,
	# where returning is still possible.
	if ! chroot /newroot /usr/local/bin/busybox true; then
		log "stage 2: the new root cannot execute its own BusyBox"
		stage2_cleanup
		return 1
	fi
	if ! chroot /newroot /usr/local/bin/busybox test -x /sbin/init; then
		log "stage 2: /sbin/init is not executable inside the new root"
		stage2_cleanup
		return 1
	fi

	mkdir -p /newroot/proc /newroot/sys /newroot/dev /newroot/mnt/lower /newroot/mnt/rw

	log "stage 2: switching root into Ubuntu Base 26.04"

	# Last log line that can be seen: /dev goes away with the move below, and
	# with it /dev/console and /dev/kmsg.
	moved=
	move_failed=false
	for mountpoint in /mnt/lower /mnt/rw /proc /sys /dev; do
		if mount -o move "$mountpoint" "/newroot$mountpoint"; then
			moved="$mountpoint $moved"
		else
			move_failed=true
			break
		fi
	done
	if [ "$move_failed" = true ]; then
		for mountpoint in $moved; do
			mount -o move "/newroot$mountpoint" "$mountpoint" 2>/dev/null || true
		done
		log "stage 2: cannot move the kernel filesystems into the new root"
		stage2_cleanup
		return 1
	fi

	# The stage-1 daemons must not survive: after switch_root their root
	# directory is the deleted initramfs, so a telnet session would land in an
	# empty filesystem, and they would hold 192.168.7.2:2323 against the copies
	# Ubuntu is about to start.
	#
	# This is deliberately the last statement before the exec, and it used to sit
	# above the mount -o move loop. That placement was the single hole in
	# "every stage-2 failure falls back to the telnet shell": when the move
	# failed, the rollback above put the mounts back and returned, but telnetd
	# and udhcpd were already dead, and that one grid square had nothing but the
	# panel and the power button. Nothing below here can fail into a return.
	#
	# /proc moved into the new root a moment ago, so a plain `killall` would scan
	# an empty directory and cheerfully report having killed nothing. Run the new
	# root's BusyBox under chroot, where /proc is mounted again -- the same
	# binary the probe above already executed. The pid file is read from /run,
	# which is not in the move list and is therefore still ours.
	if [ -f /run/udhcpd.pid ]; then
		kill "$(cat /run/udhcpd.pid)" 2>/dev/null || true
	fi
	chroot /newroot /usr/local/bin/busybox killall telnetd udhcpd 2>/dev/null || true

	exec switch_root /newroot /sbin/init
}

if [ "$storage_mode" = readonly ] && [ -f "$storage_installer_marker" ] && [ "$ufs_safe" = true ]; then
	stage2 || log "stage 2 failed; falling back to the diagnostic initramfs"
else
	log "stage 2 withheld: the read-only guard did not pass"
fi

log "pstore is available at /sys/fs/pstore; UFS was not mounted"
if [ "$storage_mode" = readonly ] && [ -f "$storage_installer_marker" ] && [ "$ufs_safe" = true ]; then
	log "starting installer local emergency shell"
	while true; do setsid cttyhack sh; sleep 1; done
fi
log "boot failed; storage sealed, boot the installer explicitly for recovery"
while true; do sleep 60; done
